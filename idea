#!/usr/bin/env python3
# Open a file in IntelliJ IDEA and raise its window on Wayland.
#
# On Wayland a backgrounded IDE cannot focus itself, and the `idea` launcher
# only forwards "open this" to the running instance over a socket and exits,
# so nothing brings the window forward.  wl-focus asks the Switchboard
# GNOME Shell extension to raise the window by ID, bypassing focus-stealing
# prevention.
import os
import re
import subprocess
import sys

REAL_IDEA = os.path.expanduser("~/.local/bin/idea")


def parse_args(argv):
    line = None
    column = None
    paths = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--line", "-l"):
            i += 1
            if i >= len(argv):
                sys.exit("idea: --line requires a value")
            line = argv[i]
        elif arg.startswith("--line="):
            line = arg[len("--line="):]
        elif arg in ("--column", "-c"):
            i += 1
            if i >= len(argv):
                sys.exit("idea: --column requires a value")
            column = argv[i]
        elif arg.startswith("--column="):
            column = arg[len("--column="):]
        elif arg.startswith("-") and arg != "-":
            sys.exit(f"idea: unknown option {arg!r}")
        else:
            paths.append(arg)
        i += 1
    # Mirrors the real launcher's own usage: a bare file, or a project dir
    # followed by a file inside it (this is how Paseo's "open in editor" calls it).
    if len(paths) not in (1, 2):
        sys.exit("idea: expected one or two path arguments (file, or project dir + file)")
    return paths, line, column


def git_toplevel():
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True, capture_output=True, text=True,
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError:
        return None


def project_root(path):
    candidate = os.path.abspath(path)
    if not os.path.isdir(candidate):
        candidate = os.path.dirname(candidate)
    while candidate != os.path.dirname(candidate):
        if os.path.isdir(os.path.join(candidate, ".idea")):
            return candidate
        candidate = os.path.dirname(candidate)
    return None


paths, line, column = parse_args(sys.argv[1:])

line_col = []
if line is not None:
    line_col += ["--line", line]
if column is not None:
    line_col += ["--column", column]


def launch(args):
    return subprocess.Popen([REAL_IDEA] + args)


def wl_focus(regexes, wait):
    # Returns True if a matching window was found (and raised).
    args = ["wl-focus", "--wm-class", "jetbrains-idea"]
    for regex in regexes:
        args += ["--title-regex", regex]
    args += ["--wait", str(wait)]
    return subprocess.run(args).returncode == 0


if len(paths) == 2:
    # Caller already knows the project dir; skip the ancestor search below.
    project_dir, target_file = (os.path.abspath(p) for p in paths)
    root = project_dir
    launch_paths = None
else:
    path = paths[0]
    toplevel = git_toplevel()
    # A relative path is cwd-relative first; fall back to the git root, like
    # open-idea-fileline, then make it absolute for the launcher.
    if not os.path.isabs(path):
        if not os.path.isfile(path) and toplevel and os.path.isfile(os.path.join(toplevel, path)):
            path = os.path.join(toplevel, path)
    path = os.path.abspath(path)

    if not os.path.isdir(path):
        # A single file opens in LightEdit: a standalone editor with no project,
        # so the file always lands in it rather than in whatever project frame is
        # frontmost.  Its window shares wm_class with project windows; the title
        # leads with the basename and an ASCII hyphen, where project windows lead
        # with the project name and an en-dash.
        rc = launch(["-e"] + line_col + [path]).wait()
        basename = re.escape(os.path.basename(path))
        wl_focus((rf"^{basename}\s+-\s", rf"^{basename}\b"), 10)
        sys.exit(rc)

    # A directory with no .idea of its own makes IDEA offer to create a project.
    root = project_root(path) or toplevel
    launch_paths = [project_root(path) or path]
    target_file = None

# Without an owning project there is no window to raise deterministically: open
# the paths as given and let the launcher place them.
if not root:
    sys.exit(launch(launch_paths).wait())

abs_root = os.path.abspath(root)
name = re.escape(os.path.basename(abs_root))
parent = re.escape(os.path.basename(os.path.dirname(abs_root)))
# A project renamed to carry its parent directory is titled "parent/leaf";
# the default title is the leaf name alone.
proj = rf"(?:{parent}/)?{name}"

# Same-named projects are told apart by the parent directory in IDEA's
# "name [path]" label.  Two projects that share both leaf and parent names
# (e.g. /a/work/proj and /b/work/proj) still collide; the label regex then
# matches whichever window Switchboard lists first.
label = rf"^{proj}\s+\[[^\]]*\b{parent}\b"
plain = rf"^{proj}\s+[-–]\s+"
# With no file open the new UI titles the window "name branch parent/leaf",
# the path breadcrumb ending in the project's own parent/leaf directories.
nofile = rf"^{proj}\s+.*\b{parent}/{name}\b"
# A window that is still opening is titled just the project name, before the
# branch and path widgets populate.
bare = rf"^{proj}$"
# The owning project's window once it holds the target file.  The path in the
# title may be truncated with an ellipsis but keeps the file's basename.
in_project_file = rf"^{proj}\b.*{re.escape(os.path.basename(target_file))}" if target_file else None
# The project is populated (its branch/path widgets are up) once the title takes
# any form other than the bare name; the bare form is only the loading state.
populated = (label, plain, nofile)

# A directory or project-only target: open it and raise it.
if target_file is None:
    rc = launch(launch_paths).wait()
    wl_focus((label, plain, nofile, bare), 10)
    sys.exit(rc)

# IDEA routes a file to an already-open project whose content contains it, but
# falls back to the last-focused frame when that project is closed.  Open the
# owning project first and wait until it is populated (not just its bare loading
# title) so the file lands in it rather than whatever frame is frontmost.
if not wl_focus(populated, 0):
    launch([abs_root])
    wl_focus(populated, 30)

# A file opened right as the project finishes loading can still lose the routing
# race and land in the last-focused frame; retry until the project's own window
# shows the file.
rc = 0
for _ in range(3):
    rc = launch(line_col + [target_file]).wait()
    if wl_focus((in_project_file,), 10):
        sys.exit(rc)
wl_focus((label, plain, nofile, bare), 5)
sys.exit(rc)
