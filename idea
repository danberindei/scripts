#!/usr/bin/env python3
# Open a file in IntelliJ IDEA and raise its window on Wayland.
#
# On Wayland a backgrounded IDE cannot focus itself, and the `idea` launcher
# only forwards "open this" to the running instance over a socket and exits,
# so nothing brings the window forward.  wl-focus asks the Switchboard
# GNOME Shell extension to raise the window by ID, bypassing focus-stealing
# prevention.
import os
import re
import subprocess
import sys

REAL_IDEA = os.path.expanduser("~/.local/bin/idea")


def parse_args(argv):
    line = None
    column = None
    paths = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--line", "-l"):
            i += 1
            if i >= len(argv):
                sys.exit("idea: --line requires a value")
            line = argv[i]
        elif arg.startswith("--line="):
            line = arg[len("--line="):]
        elif arg in ("--column", "-c"):
            i += 1
            if i >= len(argv):
                sys.exit("idea: --column requires a value")
            column = argv[i]
        elif arg.startswith("--column="):
            column = arg[len("--column="):]
        elif arg.startswith("-") and arg != "-":
            sys.exit(f"idea: unknown option {arg!r}")
        else:
            paths.append(arg)
        i += 1
    # Mirrors the real launcher's own usage: a bare file, or a project dir
    # followed by a file inside it (this is how Paseo's "open in editor" calls it).
    if len(paths) not in (1, 2):
        sys.exit("idea: expected one or two path arguments (file, or project dir + file)")
    return paths, line, column


def git_toplevel():
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True, capture_output=True, text=True,
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError:
        return None


def project_root(path):
    candidate = os.path.abspath(path)
    if not os.path.isdir(candidate):
        candidate = os.path.dirname(candidate)
    while candidate != os.path.dirname(candidate):
        if os.path.isdir(os.path.join(candidate, ".idea")):
            return candidate
        candidate = os.path.dirname(candidate)
    return None


paths, line, column = parse_args(sys.argv[1:])

if len(paths) == 2:
    # Caller already knows the project dir; skip the ancestor search below.
    project_dir, file_path = (os.path.abspath(p) for p in paths)
    launch_paths = [project_dir, file_path]
    root = project_dir
else:
    path = paths[0]
    toplevel = git_toplevel()
    # A relative path is cwd-relative first; fall back to the git root, like
    # open-idea-fileline, then make it absolute for the launcher.
    if not os.path.isabs(path):
        if not os.path.isfile(path) and toplevel and os.path.isfile(os.path.join(toplevel, path)):
            path = os.path.join(toplevel, path)
    path = os.path.abspath(path)

    # A directory with no .idea of its own makes IDEA offer to create a project.
    if os.path.isdir(path):
        launch_path = project_root(path) or path
    else:
        launch_path = path

    launch_paths = [launch_path]
    # Raise the project window.  IDEA titles a window with the project directory
    # name (the .idea ancestor), or the git root's basename when there is no .idea.
    root = project_root(path) or toplevel

real_args = [REAL_IDEA]
if line is not None:
    real_args += ["--line", line]
if column is not None:
    real_args += ["--column", column]
real_args += launch_paths
launcher = subprocess.Popen(real_args)
if not root:
    sys.exit(launcher.wait())

abs_root = os.path.abspath(root)
name = re.escape(os.path.basename(abs_root))
parent = re.escape(os.path.basename(os.path.dirname(abs_root)))
# A project renamed to carry its parent directory is titled "parent/leaf";
# the default title is the leaf name alone.
proj = rf"(?:{parent}/)?{name}"

# Same-named projects are told apart by the parent directory in IDEA's
# "name [path]" label.  Two projects that share both leaf and parent names
# (e.g. /a/work/proj and /b/work/proj) still collide; the label regex then
# matches whichever window Switchboard lists first.
label = rf"^{proj}\s+\[[^\]]*\b{parent}\b"
plain = rf"^{proj}\s+[-–]\s+"
# With no file open the new UI titles the window "name branch parent/leaf",
# the path breadcrumb ending in the project's own parent/leaf directories.
nofile = rf"^{proj}\s+.*\b{parent}/{name}\b"
# A window that is still opening is titled just the project name, before the
# branch and path widgets populate.
bare = rf"^{proj}$"

subprocess.run([
    "wl-focus",
    "--wm-class", "jetbrains-idea",
    "--title-regex", label,
    "--title-regex", plain,
    "--title-regex", nofile,
    "--title-regex", bare,
    "--wait", "10",
])

sys.exit(launcher.wait())
