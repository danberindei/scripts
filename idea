#!/usr/bin/env python3
# Open a project in IntelliJ IDEA and raise its window on Wayland.
#
# On Wayland a backgrounded IDE cannot focus itself, and the `idea` launcher
# only forwards "open this" to the running instance over a socket and exits,
# so nothing brings the window forward.  wl-focus asks the Switchboard
# GNOME Shell extension to raise the window by ID, bypassing focus-stealing
# prevention.
import os
import re
import subprocess
import sys

REAL_IDEA = os.path.expanduser("~/.local/bin/idea")

args = sys.argv[1:]

def non_option_paths(argv):
    paths = []
    skip_next = False
    for arg in argv:
        if skip_next:
            skip_next = False
            continue
        if arg in {"--line", "-l"}:
            skip_next = True
            continue
        if arg.startswith("-"):
            continue
        paths.append(arg)
    return paths


def project_root(path):
    candidate = os.path.abspath(path)
    if not os.path.isdir(candidate):
        candidate = os.path.dirname(candidate)
    while candidate != os.path.dirname(candidate):
        if os.path.isdir(os.path.join(candidate, ".idea")):
            return candidate
        candidate = os.path.dirname(candidate)
    return None


def choose_target(argv):
    paths = non_option_paths(argv)
    for path in reversed(paths):
        root = project_root(path)
        if root:
            return root
    return paths[0] if paths else None


def focus(title_regex, wait="0"):
    return subprocess.run([
        "wl-focus",
        "--wm-class", "jetbrains-idea",
        "--title-regex", title_regex,
        "--wait", wait,
    ]).returncode == 0


target = choose_target(args)
subprocess.run([REAL_IDEA] + args)

if not target:
    sys.exit(0)

abs_target = os.path.abspath(target)
name = re.escape(os.path.basename(abs_target))
parent = re.escape(os.path.basename(os.path.dirname(abs_target)))

paths = non_option_paths(args)
opened_file = paths[-1] if paths and os.path.abspath(paths[-1]) != abs_target else None

# Same-named projects always differ in parent directory, and IDEA labels a
# window "name [path]" only while a same-named one is open.  Match the parent
# in that label, else a title with no label, else the just-opened file.
if not focus(rf"^{name}\s+\[[^\]]*\b{parent}\b"):
    if not focus(rf"^{name}\s+[-–]\s+"):
        if opened_file is not None:
            file_name = re.escape(os.path.basename(opened_file))
            focus(rf"^{name}(\s+\[[^\]]*\])?\s+[-–]\s+.*{file_name}", "10")
