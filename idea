#!/usr/bin/env python3
# Open a project in IntelliJ IDEA and raise its window on Wayland.
#
# On Wayland a backgrounded IDE cannot focus itself, and the `idea` launcher
# only forwards "open this" to the running instance over a socket and exits,
# so nothing brings the window forward.  wl-focus asks the Switchboard
# GNOME Shell extension to raise the window by ID, bypassing focus-stealing
# prevention.
import os
import re
import subprocess
import sys

args = sys.argv[1:]

def non_option_paths(argv):
    paths = []
    skip_next = False
    for arg in argv:
        if skip_next:
            skip_next = False
            continue
        if arg in {"--line", "-l"}:
            skip_next = True
            continue
        if arg.startswith("-"):
            continue
        paths.append(arg)
    return paths


def choose_target(argv):
    paths = non_option_paths(argv)
    for path in paths:
        if os.path.isdir(path) and os.path.isdir(os.path.join(path, ".idea")):
            return path
    return paths[0] if paths else None


target = choose_target(args)
if not target:
    subprocess.run(["wl-focus", "--skip-realpath", os.path.realpath(__file__), "--", "idea"] + args)
    sys.exit(0)

project_name = os.path.basename(os.path.abspath(target))
title_regex = r"^" + re.escape(project_name) + r"\s+[-\u2013]\s+.*"

subprocess.run([
    "wl-focus",
    "--wm-class", "jetbrains-idea",
    "--title-regex", title_regex,
    "--wait", "10",
    "--skip-realpath", os.path.realpath(__file__),
    "--", "idea",
] + args)
