#!/usr/bin/env python3

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import xml.etree.ElementTree as ET

from idea_http import request_json


USAGE = """Usage: idea-jira <ISSUE-KEY>
  Creates or reuses a git branch, IDEA task, and IDEA changelist for a Jira issue"""


def usage(exit_code: int = 1) -> None:
    stream = sys.stdout if exit_code == 0 else sys.stderr
    print(USAGE, file=stream)
    raise SystemExit(exit_code)


def fatal(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def run_command(args: list[str], *, capture_output: bool = True, check: bool = True):
    try:
        return subprocess.run(
            args,
            check=check,
            text=True,
            capture_output=capture_output,
        )
    except FileNotFoundError as exc:
        raise RuntimeError(f"command not found: {args[0]}") from exc


def command_output(args: list[str]) -> str:
    return run_command(args).stdout


def optional_json(method: str, endpoint: str):
    try:
        return request_json(method, endpoint)
    except Exception:
        return None


def optional_json_for_path(method: str, endpoint: str, project_path: str):
    try:
        return request_json(method, endpoint, project_path=project_path)
    except Exception:
        return None


def jira_summary(issue: str) -> str:
    payload = json.loads(command_output(["jira", "issue", "view", issue, "--raw"]))
    return payload["fields"]["summary"]


def copilot_text(issue: str, summary: str) -> str:
    prompt = (
        f"Jira issue: {issue}\n"
        f"Summary: {summary}\n\n"
        "Output EXACTLY one line, nothing else:\n"
        "A short branch name slug (3-5 lowercase words separated by underscores, no hyphens, no punctuation)"
    )
    result = run_command(
        [
            "copilot",
            "--model",
            "gpt-4.1",
            "--output-format",
            "json",
            "--no-ask-user",
            "-p",
            prompt,
        ]
    )

    parts: list[str] = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        message = json.loads(line)
        if message.get("type") != "assistant.message":
            continue
        content = message.get("data", {}).get("content", "")
        if isinstance(content, str):
            parts.append(content)
        elif isinstance(content, list):
            for item in content:
                if isinstance(item, dict) and item.get("type") == "text":
                    parts.append(item.get("text", ""))

    text = "".join(parts)
    if not text:
        raise RuntimeError("copilot returned no assistant message content")
    return text


def slugify(text: str) -> str:
    slug = re.sub(r"[^a-z0-9_]", "", text.lower())
    if not slug:
        raise RuntimeError("copilot returned an empty branch slug")
    return slug


def note_failed_step(label: str, exc: Exception) -> None:
    print(f"Note: {label}", file=sys.stderr)
    message = str(exc).strip()
    if message:
        print(message, file=sys.stderr)


def list_local_branches() -> list[str]:
    output = command_output(["git", "for-each-ref", "--format=%(refname:short)", "refs/heads"])
    return [line.strip() for line in output.splitlines() if line.strip()]


def matching_issue_branch(issue: str) -> str | None:
    current = command_output(["git", "branch", "--show-current"]).strip()
    if current.startswith(f"{issue}_"):
        return current

    matches = sorted(branch for branch in list_local_branches() if branch.startswith(f"{issue}_"))
    if len(matches) == 1:
        return matches[0]
    return None


def ensure_branch(branch: str) -> tuple[str, bool]:
    current = command_output(["git", "branch", "--show-current"]).strip()
    if current == branch:
        return branch, True

    exists = subprocess.run(
        ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
        check=False,
        capture_output=True,
        text=True,
    ).returncode == 0

    if exists:
        run_command(["git", "checkout", branch], capture_output=False)
        return branch, True

    run_command(["git", "checkout", "-b", branch], capture_output=False)
    return branch, False


def find_issue_task(tasks, issue: str) -> dict | None:
    if not isinstance(tasks, list):
        return None

    prefix = f"{issue} "
    for task in tasks:
        if not isinstance(task, dict):
            continue
        task_id = task.get("id")
        summary = task.get("summary")
        if task_id == issue or summary == issue:
            return task
        if isinstance(summary, str) and summary.startswith(prefix):
            return task
    return None


def find_issue_changelist(changelists, issue: str) -> dict | None:
    if not isinstance(changelists, list):
        return None

    matches: list[dict] = []
    prefix = f"{issue} "
    for changelist in changelists:
        if not isinstance(changelist, dict):
            continue
        name = changelist.get("name")
        if name == issue or (isinstance(name, str) and name.startswith(prefix)):
            matches.append(changelist)

    if not matches:
        return None

    default_matches = [item for item in matches if item.get("default")]
    return default_matches[0] if default_matches else matches[0]


def find_changelist_by_name(changelists, name: str) -> dict | None:
    if not isinstance(changelists, list):
        return None
    for changelist in changelists:
        if isinstance(changelist, dict) and changelist.get("name") == name:
            return changelist
    return None


def candidate_project_paths() -> list[str]:
    git_root = Path(command_output(["git", "rev-parse", "--show-toplevel"]).strip()).resolve()
    candidates = [git_root]
    candidates.extend(candidate for candidate in git_root.parents if (candidate / ".idea").exists())
    candidates.extend(related_open_project_paths(git_root))

    seen: set[str] = set()
    ordered: list[str] = []
    for candidate in candidates:
        resolved = str(candidate.resolve())
        if resolved not in seen:
            seen.add(resolved)
            ordered.append(resolved)
    return ordered


def expand_recent_project_path(value: str) -> str:
    return value.replace("$USER_HOME$", str(Path.home()))


def is_related_project(candidate: Path, git_root: Path) -> bool:
    if candidate == git_root:
        return True

    git_parent = git_root.parent
    return (
        git_root in candidate.parents
        or candidate in git_root.parents
        or candidate.parent == git_parent
        or git_parent in candidate.parents
    )


def related_open_project_paths(git_root: Path) -> list[Path]:
    config_root = Path.home() / ".config" / "JetBrains"
    recent_projects_files = sorted(
        config_root.glob("IntelliJIdea*/options/recentProjects.xml"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )

    related_paths: list[Path] = []
    for recent_projects in recent_projects_files:
        try:
            root = ET.parse(recent_projects).getroot()
        except ET.ParseError:
            continue

        for entry in root.findall(".//entry"):
            key = entry.get("key")
            project = entry.find("./value/RecentProjectMetaInfo")
            if not key or project is None or project.get("opened") != "true":
                continue

            candidate = Path(os.path.realpath(expand_recent_project_path(key)))
            if is_related_project(candidate, git_root):
                related_paths.append(candidate)

    return related_paths


def resolve_project_context() -> tuple[str, object, object]:
    configured = os.environ.get("IDEA_PROJECT_PATH")
    if configured:
        project_path = os.path.realpath(configured)
        tasks = optional_json_for_path("GET", "/tasks", project_path)
        changelists = optional_json_for_path("GET", "/changelists", project_path)
        if tasks is not None or changelists is not None:
            return (project_path, tasks, changelists)

    candidates = candidate_project_paths()
    for candidate in candidates:
        tasks = optional_json_for_path("GET", "/tasks", candidate)
        changelists = optional_json_for_path("GET", "/changelists", candidate)
        if tasks is not None or changelists is not None:
            return candidate, tasks, changelists

    return candidates[0], None, None


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] in {"-h", "--help"}:
        usage(0)

    if len(argv) != 2:
        usage()

    issue = argv[1]
    project_path, tasks, changelists = resolve_project_context()
    os.environ["IDEA_PROJECT_PATH"] = project_path

    summary = jira_summary(issue)
    print(f"{issue}: {summary}")
    print(f"Project: {Path(project_path).name}")

    existing_branch = matching_issue_branch(issue)
    if existing_branch:
        branch, branch_reused = ensure_branch(existing_branch)
    else:
        copilot_out = copilot_text(issue, summary)
        lines = copilot_out.splitlines()
        slug = slugify(lines[0] if lines else "")
        branch, branch_reused = ensure_branch(f"{issue}_{slug}")

    existing_changelist = find_issue_changelist(changelists, issue)
    changelist_reused = bool(existing_changelist)
    if existing_changelist:
        changelist = existing_changelist["name"]
    else:
        changelist = f"{issue} {summary}"

    existing_task = find_issue_task(tasks, issue)
    task_reused = bool(existing_task)
    task_id = existing_task["id"] if existing_task else issue

    idea_failed = False
    if not existing_changelist:
        try:
            request_json("POST", "/changelists/create", {"name": changelist})
        except Exception as exc:
            try:
                refreshed_changelists = request_json("GET", "/changelists")
                if find_changelist_by_name(refreshed_changelists, changelist):
                    changelist_reused = True
                else:
                    note_failed_step(f"could not create IDEA changelist '{changelist}'", exc)
                    idea_failed = True
            except Exception:
                note_failed_step(f"could not create IDEA changelist '{changelist}'", exc)
                idea_failed = True

    if not idea_failed:
        try:
            request_json("POST", "/changelists/set-default", {"name": changelist})
        except Exception as exc:
            try:
                refreshed_changelists = request_json("GET", "/changelists")
                selected = find_changelist_by_name(refreshed_changelists, changelist)
                if not (isinstance(selected, dict) and selected.get("default")):
                    note_failed_step(f"could not set default IDEA changelist '{changelist}'", exc)
                    idea_failed = True
            except Exception:
                note_failed_step(f"could not set default IDEA changelist '{changelist}'", exc)
                idea_failed = True

    if not (existing_task and existing_task.get("active")):
        try:
            request_json("POST", "/tasks/open", {"id": task_id, "changelist": changelist, "summary": f"{issue} {summary}"})
        except Exception as exc:
            try:
                refreshed_tasks = request_json("GET", "/tasks")
                matched_task = find_issue_task(refreshed_tasks, issue)
                if matched_task:
                    task_id = matched_task.get("id", issue)
                    task_reused = True
                    if not matched_task.get("active"):
                        note_failed_step(f"could not open IDEA task '{task_id}'", exc)
                        idea_failed = True
                else:
                    note_failed_step(f"could not open IDEA task '{task_id}'", exc)
                    idea_failed = True
            except Exception:
                note_failed_step(f"could not open IDEA task '{task_id}'", exc)
                idea_failed = True

    if idea_failed:
        print(
            f"Note: IDEA integration uses http://localhost:63344 for project {project_path}",
            file=sys.stderr,
        )

    branch_status = "reused" if branch_reused else "created"
    changelist_status = "reused" if changelist_reused else "created"
    task_status = "reused" if task_reused else "created"
    print(f"Branch: {branch} ({branch_status})")
    print(f"Changelist: {changelist} ({changelist_status})")
    print(f"Task: {task_id} ({task_status})")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except subprocess.CalledProcessError as exc:
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        detail = stderr or stdout or str(exc)
        raise SystemExit(fatal(detail))
    except (RuntimeError, json.JSONDecodeError, KeyError) as exc:
        raise SystemExit(fatal(str(exc)))
