#!/usr/bin/env python3

import json
import os
from pathlib import Path
import subprocess
import sys
import xml.etree.ElementTree as ET

from idea_http import request_json


USAGE = """Usage: idea-jira <ISSUE-KEY> [BRANCH] [--dry-run]
  Creates or reuses a git branch, IDEA task, and IDEA changelist for a Jira issue
  If BRANCH is omitted, reuses an existing branch (from git or the IDEA task);
  fails if none can be resolved - pass BRANCH to create a new one
  A new branch starts from the local main or master branch, not from HEAD
  --dry-run reports what would be done without making any changes"""

PROTECTED_BRANCHES = {"main", "master", "HEAD"}


def usage(exit_code: int = 1) -> None:
    stream = sys.stdout if exit_code == 0 else sys.stderr
    print(USAGE, file=stream)
    raise SystemExit(exit_code)


def fatal(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def run_command(args: list[str], *, capture_output: bool = True, check: bool = True, cwd: Path | None = None):
    try:
        return subprocess.run(
            args,
            check=check,
            text=True,
            capture_output=capture_output,
            cwd=cwd,
        )
    except FileNotFoundError as exc:
        raise RuntimeError(f"command not found: {args[0]}") from exc


def command_output(args: list[str], cwd: Path | None = None) -> str:
    return run_command(args, cwd=cwd).stdout


def optional_json(method: str, endpoint: str):
    try:
        return request_json(method, endpoint)
    except Exception:
        return None


def optional_json_for_path(method: str, endpoint: str, project_path: str):
    try:
        return request_json(method, endpoint, project_path=project_path)
    except Exception:
        return None


def jira_summary(issue: str) -> str:
    payload = json.loads(command_output(["jira", "issue", "view", issue, "--raw"]))
    return payload["fields"]["summary"]


def note_failed_step(label: str, exc: Exception) -> None:
    print(f"Note: {label}", file=sys.stderr)
    message = str(exc).strip()
    if message:
        print(message, file=sys.stderr)


def is_git_work_tree(path: Path) -> bool:
    if not path.is_dir():
        return False
    result = subprocess.run(
        ["git", "rev-parse", "--is-inside-work-tree"],
        check=False,
        capture_output=True,
        text=True,
        cwd=path,
    )
    return result.returncode == 0 and result.stdout.strip() == "true"


def git_roots_from_project(project_path: str) -> list[Path]:
    vcs_xml = Path(project_path) / ".idea" / "vcs.xml"
    if not vcs_xml.exists():
        return []

    try:
        root = ET.parse(vcs_xml).getroot()
    except ET.ParseError:
        return []

    roots: list[Path] = []
    for mapping in root.findall(".//mapping"):
        if mapping.get("vcs") != "Git":
            continue
        directory = mapping.get("directory", "") or "$PROJECT_DIR$"
        directory = directory.replace("$PROJECT_DIR$", project_path)
        resolved = Path(os.path.realpath(directory))
        if is_git_work_tree(resolved):
            roots.append(resolved)

    return roots


def git_roots_for_issue(project_path: str) -> list[Path]:
    roots = git_roots_from_project(project_path)
    if not roots:
        roots = [Path(command_output(["git", "rev-parse", "--show-toplevel"], cwd=Path(project_path)).strip()).resolve()]

    seen: set[Path] = set(roots)
    workspace_projects = optional_json_for_path("GET", "/projects", project_path) or []
    for project in workspace_projects:
        base_path = project.get("basePath", "")
        if not base_path:
            continue
        resolved = Path(os.path.realpath(base_path))
        for r in git_roots_from_project(str(resolved)):
            if r not in seen:
                seen.add(r)
                roots.append(r)

    return roots


def list_local_branches(cwd: Path | None = None) -> list[str]:
    output = command_output(["git", "for-each-ref", "--format=%(refname:short)", "refs/heads"], cwd=cwd)
    return [line.strip() for line in output.splitlines() if line.strip()]


def matching_issue_branch(issue: str, cwd: Path | None = None) -> str | None:
    current = command_output(["git", "branch", "--show-current"], cwd=cwd).strip()
    if current.startswith(f"{issue}_"):
        return current

    matches = sorted(branch for branch in list_local_branches(cwd=cwd) if branch.startswith(f"{issue}_"))
    if len(matches) == 1:
        return matches[0]
    return None


def branch_exists(branch: str, git_roots: list[Path]) -> bool:
    for git_root in git_roots:
        result = subprocess.run(
            ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
            check=False,
            capture_output=True,
            text=True,
            cwd=git_root,
        )
        if result.returncode == 0:
            return True
    return False


def task_feature_branch(task: dict | None) -> str | None:
    if not task:
        return None
    branches = task.get("branches")
    if not isinstance(branches, list):
        return None

    feature_names: list[str] = []
    other_names: list[str] = []
    for branch in branches:
        if not isinstance(branch, dict):
            continue
        name = branch.get("name")
        if not name:
            continue
        if branch.get("original"):
            other_names.append(name)
        else:
            feature_names.append(name)

    names = feature_names or other_names
    return names[0] if names else None


def branch_from_task(issue: str, task: dict | None, git_roots: list[Path]) -> str:
    task_branch = task_feature_branch(task)
    if task_branch:
        if task_branch in PROTECTED_BRANCHES:
            raise RuntimeError(
                f"IDEA task {issue} is associated with protected branch "
                f"'{task_branch}'; pass an explicit branch name"
            )
        if not branch_exists(task_branch, git_roots):
            raise RuntimeError(
                f"IDEA task {issue} branch '{task_branch}' no longer exists in git; "
                "pass an explicit branch name"
            )
        return task_branch
    if task is not None:
        raise RuntimeError(
            f"IDEA task {issue} has no feature branch recorded; pass an explicit "
            "branch name"
        )
    raise RuntimeError(
        f"no existing branch found for {issue} and no IDEA task to derive one from; "
        "pass an explicit branch name"
    )


def base_branch(branch: str, cwd: Path | None = None) -> str:
    # both main and master can exist locally; origin/HEAD says which one the remote uses
    origin_head = run_command(
        ["git", "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"],
        check=False,
        cwd=cwd,
    ).stdout.strip()
    candidates = [origin_head.split("/", 1)[1]] if "/" in origin_head else []
    candidates += ["main", "master"]
    for name in candidates:
        if branch_exists(name, [cwd]):
            return name
    raise RuntimeError(f"no local main or master branch to start '{branch}' from")


def ensure_branch(branch: str, cwd: Path | None = None) -> tuple[str, bool]:
    current = command_output(["git", "branch", "--show-current"], cwd=cwd).strip()
    if current == branch:
        return branch, True

    exists = subprocess.run(
        ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
        check=False,
        capture_output=True,
        text=True,
        cwd=cwd,
    ).returncode == 0

    if exists:
        run_command(["git", "checkout", branch], capture_output=False, cwd=cwd)
        return branch, True

    run_command(["git", "checkout", "-b", branch, base_branch(branch, cwd=cwd)], capture_output=False, cwd=cwd)
    return branch, False


def find_issue_task(tasks, issue: str) -> dict | None:
    if not isinstance(tasks, list):
        return None

    prefix = f"{issue} "
    for task in tasks:
        if not isinstance(task, dict):
            continue
        task_id = task.get("id")
        summary = task.get("summary")
        if task_id == issue or summary == issue:
            return task
        if isinstance(summary, str) and summary.startswith(prefix):
            return task
    return None


def find_issue_changelist(changelists, issue: str) -> dict | None:
    if not isinstance(changelists, list):
        return None

    matches: list[dict] = []
    prefix = f"{issue} "
    for changelist in changelists:
        if not isinstance(changelist, dict):
            continue
        name = changelist.get("name")
        if name == issue or (isinstance(name, str) and name.startswith(prefix)):
            matches.append(changelist)

    if not matches:
        return None

    default_matches = [item for item in matches if item.get("default")]
    return default_matches[0] if default_matches else matches[0]


def find_changelist_by_name(changelists, name: str) -> dict | None:
    if not isinstance(changelists, list):
        return None
    for changelist in changelists:
        if isinstance(changelist, dict) and changelist.get("name") == name:
            return changelist
    return None


def candidate_project_paths() -> list[str]:
    git_root = Path(command_output(["git", "rev-parse", "--show-toplevel"]).strip()).resolve()
    candidates = [git_root]
    candidates.extend(candidate for candidate in git_root.parents if (candidate / ".idea").exists())

    seen: set[str] = set()
    ordered: list[str] = []
    for candidate in candidates:
        resolved = str(candidate.resolve())
        if resolved not in seen:
            seen.add(resolved)
            ordered.append(resolved)
    return ordered


def resolve_project_context() -> tuple[str, object, object]:
    configured = os.environ.get("IDEA_PROJECT_PATH")
    if configured:
        project_path = os.path.realpath(configured)
        tasks = optional_json_for_path("GET", "/tasks", project_path)
        changelists = optional_json_for_path("GET", "/changelists", project_path)
        if tasks is not None or changelists is not None:
            return (project_path, tasks, changelists)

    candidates = candidate_project_paths()
    for candidate in candidates:
        tasks = optional_json_for_path("GET", "/tasks", candidate)
        changelists = optional_json_for_path("GET", "/changelists", candidate)
        if tasks is not None or changelists is not None:
            return candidate, tasks, changelists

    return candidates[0], None, None


def main(argv: list[str]) -> int:
    if any(arg in {"-h", "--help"} for arg in argv[1:]):
        usage(0)

    dry_run = False
    positional: list[str] = []
    for arg in argv[1:]:
        if arg == "--dry-run":
            dry_run = True
        else:
            positional.append(arg)

    if len(positional) not in {1, 2}:
        usage()

    issue = positional[0]
    requested_branch = positional[1] if len(positional) == 2 else None
    project_path, tasks, changelists = resolve_project_context()
    os.environ["IDEA_PROJECT_PATH"] = project_path

    summary = jira_summary(issue)
    print(f"{issue}: {summary}")
    print(f"Project: {Path(project_path).name}")

    git_roots = git_roots_for_issue(project_path)

    existing_task = find_issue_task(tasks, issue)
    task_reused = bool(existing_task)
    task_id = existing_task["id"] if existing_task else issue
    task_summary = f"{issue} {summary}"

    existing_branch = None
    for git_root in git_roots:
        existing_branch = matching_issue_branch(issue, cwd=git_root)
        if existing_branch:
            break

    if requested_branch:
        branch = requested_branch
    elif existing_branch:
        branch = existing_branch
    else:
        branch = branch_from_task(issue, existing_task, git_roots)

    existing_changelist = find_issue_changelist(changelists, issue)
    changelist_reused = bool(existing_changelist)
    if existing_changelist:
        changelist = existing_changelist["name"]
    else:
        changelist = f"{issue} {summary}"

    if dry_run:
        branch_status = "reuse" if (existing_branch or branch_exists(branch, git_roots)) else "create"
        changelist_status = "reuse" if changelist_reused else "create"
        task_status = "reuse" if task_reused else "create"
        print("Dry run, no changes made:")
        print(f"Branch: {branch} ({branch_status})")
        print(f"Changelist: {changelist} ({changelist_status})")
        print(f"Task: {task_summary} ({task_status})")
        return 0

    idea_failed = False
    if not existing_changelist:
        try:
            request_json("POST", "/changelists/create", {"name": changelist})
        except Exception as exc:
            try:
                refreshed_changelists = request_json("GET", "/changelists")
                if find_changelist_by_name(refreshed_changelists, changelist):
                    changelist_reused = True
                else:
                    note_failed_step(f"could not create IDEA changelist '{changelist}'", exc)
                    idea_failed = True
            except Exception:
                note_failed_step(f"could not create IDEA changelist '{changelist}'", exc)
                idea_failed = True

    if not idea_failed:
        try:
            request_json("POST", "/changelists/set-default", {"name": changelist})
        except Exception as exc:
            try:
                refreshed_changelists = request_json("GET", "/changelists")
                selected = find_changelist_by_name(refreshed_changelists, changelist)
                if not (isinstance(selected, dict) and selected.get("default")):
                    note_failed_step(f"could not set default IDEA changelist '{changelist}'", exc)
                    idea_failed = True
            except Exception:
                note_failed_step(f"could not set default IDEA changelist '{changelist}'", exc)
                idea_failed = True

    branch_reused = True
    failed_git_roots: list[Path] = []
    for git_root in git_roots:
        try:
            _, reused = ensure_branch(branch, cwd=git_root)
            if not reused:
                branch_reused = False
        except subprocess.CalledProcessError as exc:
            stderr = (exc.stderr or "").strip()
            stdout = (exc.stdout or "").strip()
            detail = stderr or stdout or str(exc)
            print(f"Note: could not create branch '{branch}' in {git_root}: {detail}", file=sys.stderr)
            failed_git_roots.append(git_root)
        except RuntimeError as exc:
            print(f"Note: could not create branch '{branch}' in {git_root}: {exc}", file=sys.stderr)
            failed_git_roots.append(git_root)

    try:
        result = request_json(
            "POST",
            "/tasks/open",
            {"id": task_id, "summary": task_summary, "changelist": changelist, "branch": branch},
        )
        if isinstance(result, dict) and result.get("warning"):
            print(f"Note: {result['warning']}", file=sys.stderr)
    except Exception as exc:
        try:
            refreshed_tasks = request_json("GET", "/tasks")
            matched_task = find_issue_task(refreshed_tasks, issue)
            if matched_task:
                task_id = matched_task.get("id", issue)
                task_reused = True
                if not matched_task.get("active"):
                    note_failed_step(f"could not open IDEA task '{task_id}'", exc)
                    idea_failed = True
            else:
                note_failed_step(f"could not open IDEA task '{task_id}'", exc)
                idea_failed = True
        except Exception:
            note_failed_step(f"could not open IDEA task '{task_id}'", exc)
            idea_failed = True

    if idea_failed:
        print(
            f"Note: IDEA integration uses http://localhost:63344 for project {project_path}",
            file=sys.stderr,
        )

    branch_status = "reused" if branch_reused else "created"
    if failed_git_roots:
        branch_status += ", failed in " + ", ".join(str(r) for r in failed_git_roots)
    changelist_status = "reused" if changelist_reused else "created"
    task_status = "reused" if task_reused else "created"
    print(f"Branch: {branch} ({branch_status})")
    print(f"Changelist: {changelist} ({changelist_status})")
    print(f"Task: {task_summary} ({task_status})")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except subprocess.CalledProcessError as exc:
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        detail = stderr or stdout or str(exc)
        raise SystemExit(fatal(detail))
    except (RuntimeError, json.JSONDecodeError, KeyError) as exc:
        raise SystemExit(fatal(str(exc)))
