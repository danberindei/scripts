#!/usr/bin/env python3
"""Consolidated Codex hook checks (UserPromptSubmit + PreToolUse).

Registered in ~/.codex*/hooks.json. One invocation runs the checks named on
argv, in order, and blocks on the first that fails.

Usage:
    codex-hooks CHECK [CHECK ...]
    CHECK is one of: context, quota, idle, rgflags

stdin is the hook JSON payload. A blocking check writes a JSON decision to
stdout and exits 0. No output means allow. See emit_block.

Handoff bypass: a prompt containing session-handoff is allowed through. A check
whose reason tells the agent to hand off does not block the two calls the handoff
itself needs (see handoff_call): the edit that reason interrupts, and reading the
SKILL.md it names. Every other tool call is still blocked, and rgflags still
blocks both. Each check keeps its own narrower bypasses (see the individual
functions).
"""

import json
import os
import re
import shlex
import sys
import time
from datetime import datetime, timezone

CONTEXT_LIMIT = 190000
IDLE_LIMIT = 59.5 * 60

HANDOFF_PROMPT_PATTERN = re.compile(r"session-handoff", re.IGNORECASE)
CONTEXT_BYPASS_PATTERN = re.compile(r"ignore context limit", re.IGNORECASE)
QUOTA_PERSISTENT_PATTERN = re.compile(r"ignore quota", re.IGNORECASE)
QUOTA_TEMPORARY_PATTERN = re.compile(
    r"continue in [0-9]+|snooze for [0-9.]+", re.IGNORECASE
)
IDLE_BYPASS_PATTERN = re.compile(r"\b(resume|continue)\b", re.IGNORECASE)
INJECTED_PROMPT_PATTERN = re.compile(r"<task-notification", re.IGNORECASE)
# Matches the reasons check_context and check_quota return.
HANDOFF_REASON_PATTERN = re.compile(r"/session-handoff")

WINDOWS = [
    ("five_hour", 5 * 60 * 60 * 1000, "primary"),
    ("seven_day", 7 * 24 * 60 * 60 * 1000, "secondary"),
]


def _remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def _entries(path):
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if isinstance(entry, dict):
                yield entry


def last_total_tokens(path):
    """Return the last reported context total, or None."""
    total = None
    for entry in _entries(path):
        payload = entry.get("payload") or {}
        if entry.get("type") != "event_msg" or payload.get("type") != "token_count":
            continue
        usage = (payload.get("info") or {}).get("last_token_usage") or {}
        value = usage.get("total_tokens")
        if isinstance(value, (int, float)):
            total = value
    return total


def last_agent_epoch(path):
    """Return epoch seconds for the last agent message, or None."""
    timestamp = None
    for entry in _entries(path):
        payload = entry.get("payload") or {}
        if entry.get("type") == "event_msg" and payload.get("type") == "agent_message":
            timestamp = entry.get("timestamp")
    if not timestamp:
        return None
    try:
        return datetime.fromisoformat(timestamp.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def last_user_message(path):
    """Return the newest user message in the transcript, or an empty string."""
    message = ""
    for entry in _entries(path):
        payload = entry.get("payload") or {}
        if entry.get("type") == "event_msg" and payload.get("type") == "user_message":
            value = payload.get("message")
            if isinstance(value, str):
                message = value
    return message


def last_rate_limits(path):
    """Return the newest reported rate limits, or None."""
    limits = None
    for entry in _entries(path):
        payload = entry.get("payload") or {}
        if entry.get("type") == "event_msg" and payload.get("type") == "token_count":
            value = payload.get("rate_limits")
            if isinstance(value, dict):
                limits = value
    return limits


def _bypass_path(session_id):
    return f"/tmp/codex-bypass-{session_id}"


def _load_bypass(session_id):
    try:
        with open(_bypass_path(session_id), encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    return {
        "turn": list(data.get("turn") or []),
        "session": list(data.get("session") or []),
    }


def _save_bypass(session_id, state):
    path = _bypass_path(session_id)
    if not state["turn"] and not state["session"]:
        _remove(path)
        return
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f)
        os.replace(tmp, path)
    except OSError:
        _remove(tmp)


def arm_bypass(session_id, prompt):
    """Update the bypass state from this turn's prompt and return it."""
    state = _load_bypass(session_id)
    state["turn"] = []
    if HANDOFF_PROMPT_PATTERN.search(prompt):
        state["turn"].append("all")
    if CONTEXT_BYPASS_PATTERN.search(prompt):
        state["turn"].append("context")
    if QUOTA_TEMPORARY_PATTERN.search(prompt):
        state["turn"].append("quota")
    if QUOTA_PERSISTENT_PATTERN.search(prompt) and "quota" not in state["session"]:
        state["session"].append("quota")
    _save_bypass(session_id, state)
    return state


# Checks that no bypass may unblock: a wrong flag is wrong during a handoff too.
NEVER_BYPASSED = {"rgflags"}

# Codex has no dedicated write tool; apply_patch also creates files.
HANDOFF_TOOLS = {"apply_patch"}
SHELL_TOOLS = {"exec_command", "shell", "shell_command"}


def bypassed(state, check):
    if check in NEVER_BYPASSED:
        return False
    return "all" in state["turn"] or check in state["turn"] or check in state["session"]


def handoff_call(event_name, tool_name, command):
    """True for a call the handoff itself needs: the edit a block interrupts, or
    reading the SKILL.md the block tells the agent to run."""
    if event_name != "PreToolUse":
        return False
    if tool_name in HANDOFF_TOOLS:
        return True
    return tool_name in SHELL_TOOLS and skill_read_command(command)


def transcript_path(data):
    return data.get("transcript_path") or ""


def prompt_for_turn(data):
    prompt = data.get("prompt") or ""
    if prompt:
        return prompt
    transcript = transcript_path(data)
    if not transcript:
        return ""
    try:
        return last_user_message(transcript)
    except OSError:
        return ""


def check_context(data):
    transcript = transcript_path(data)
    if not transcript:
        return None
    try:
        tokens = last_total_tokens(transcript)
    except OSError:
        return None
    if tokens is not None and tokens > CONTEXT_LIMIT:
        return (
            f"Context at {tokens} tokens (>{CONTEXT_LIMIT}) - run /session-handoff "
            "to capture the user's intent and what's left, then stop."
        )
    return None


def check_idle(data):
    prompt = prompt_for_turn(data)
    if IDLE_BYPASS_PATTERN.search(prompt):
        return None
    transcript = transcript_path(data)
    if not transcript:
        return None
    try:
        last_epoch = last_agent_epoch(transcript)
    except OSError:
        return None
    if last_epoch is None:
        return None
    idle = datetime.now(timezone.utc).timestamp() - last_epoch
    if idle > IDLE_LIMIT:
        mins = int(idle // 60)
        return (
            f"Blocked: {mins} min since the last agent reply (>{IDLE_LIMIT}s). "
            "Add 'resume' or 'continue' to the message to proceed."
        )
    return None


SHELL_OPERATORS = {"|", "||", "&&", ";", "&", "(", ")", "<", ">", ">>", "<<"}
# rg short flags whose value may itself start with a dash.
RG_VALUE_FLAGS = {"-e", "-f", "-g", "--regexp", "--file", "--glob", "--iglob"}
RG_SHORT_R = re.compile(r"^-[A-Za-z]*r[A-Za-z]*$")

HANDOFF_SKILL_PATTERN = re.compile(r"(?:^|/)session-handoff/SKILL\.md$")
# Readers with no flag that writes. head and tail also take a bare count.
FLAG_ONLY_READERS = {"cat", "nl", "wc"}
COUNT_READERS = {"head", "tail"}
COUNT_PATTERN = re.compile(r"^[0-9]+$")
# sed's script can write files, so only a line-range print is accepted.
SED_RANGE_PATTERN = re.compile(r"^[0-9]+(,[0-9]+)?p$")


def tool_command(data):
    """Return the shell command string from a PreToolUse payload, or ''.

    exec_command passes cmd as a string; shell passes command as an argv list.
    """
    tool_input = data.get("tool_input")
    if not isinstance(tool_input, dict):
        return ""
    value = tool_input.get("cmd")
    if value is None:
        value = tool_input.get("command")
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return " ".join(part for part in value if isinstance(part, str))
    return ""


def shell_tokens(command):
    """Tokenize a shell command, operators as their own tokens. [] if unparseable."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        return list(lexer)
    except ValueError:
        return []


def skill_read_command(command):
    """True if command does nothing but read a session-handoff SKILL.md.

    Newlines, backticks and $ are rejected outright: with them a permitted
    reader can carry a second command or an expansion.
    """
    if not command or any(ch in command for ch in "`$\n"):
        return False
    tokens = shell_tokens(command)
    if len(tokens) < 2 or any(token in SHELL_OPERATORS for token in tokens):
        return False
    name = os.path.basename(tokens[0])
    args, path = tokens[1:-1], tokens[-1]
    if not HANDOFF_SKILL_PATTERN.search(path):
        return False
    if name in FLAG_ONLY_READERS:
        return all(arg.startswith("-") for arg in args)
    if name in COUNT_READERS:
        return all(arg.startswith("-") or COUNT_PATTERN.match(arg) for arg in args)
    if name == "sed":
        return len(args) == 2 and args[0] == "-n" and bool(SED_RANGE_PATTERN.match(args[1]))
    return False


def rg_arg_spans(tokens):
    """Yield the argument tokens of each rg invocation in a shell token stream."""
    args = None
    for token in tokens:
        if args is None:
            if token == "rg" or token.endswith("/rg"):
                args = []
            continue
        if token in SHELL_OPERATORS:
            yield args
            args = None
            continue
        args.append(token)
    if args is not None:
        yield args


def check_rgflags(data):
    """Return a block reason when a shell command passes short -r to rg, else None.

    rg's -r is --replace=TEXT: `rg -rn PATTERN` prints the literal "n" for every
    match rather than numbering lines. r is rg's only short flag containing "r",
    so any short cluster containing it is a replace. --replace=TEXT is allowed.
    """
    command = tool_command(data)
    if "rg" not in command:
        return None
    for args in rg_arg_spans(shell_tokens(command)):
        skip = False
        for token in args:
            if skip:
                skip = False
                continue
            if token == "--":
                break
            if token in RG_VALUE_FLAGS:
                skip = True
                continue
            if RG_SHORT_R.match(token):
                return (
                    f"Blocked: `rg {token}` - rg's -r is --replace=TEXT, not "
                    "recursive, so this prints a replacement instead of matching "
                    "lines. rg already searches recursively; use `rg -n PATTERN "
                    "PATH` for line numbers. For a real replacement write "
                    "--replace=TEXT."
                )
    return None


def _round_half_up(value):
    return int(value + 0.5) if value >= 0 else -int(-value + 0.5)


def check_window(label, window, now_ms, duration_ms):
    """Return a red-pace message for this window, or None."""
    if not isinstance(window, dict):
        return None
    used = window.get("used_percent")
    reset = window.get("resets_at")
    if not isinstance(used, (int, float)) or not isinstance(reset, (int, float)):
        return None
    reset_ms = int(reset * 1000)
    if reset_ms <= now_ms:
        return None
    remaining = 100 - used
    elapsed_ms = duration_ms - max(reset_ms - now_ms, 0)
    elapsed_fraction = elapsed_ms / duration_ms
    if elapsed_fraction <= 0:
        return None
    expected_remaining = (1 - elapsed_fraction) * 100
    if remaining < expected_remaining * 0.5:
        wait_min = (reset_ms - now_ms) // 60000
        return (
            f"{label}: {_round_half_up(remaining)}% left, expected "
            f"{_round_half_up(expected_remaining)}% (resets in {wait_min}m)"
        )
    return None


def red_windows(rate_limits, now_ms):
    return [
        message
        for label, duration_ms, key in WINDOWS
        if (message := check_window(label, rate_limits.get(key), now_ms, duration_ms))
    ]


def check_quota(data):
    prompt = prompt_for_turn(data)
    if INJECTED_PROMPT_PATTERN.search(prompt):
        return None
    transcript = transcript_path(data)
    if not transcript:
        return None
    try:
        rate_limits = last_rate_limits(transcript)
    except OSError:
        return None
    if not rate_limits:
        return None
    red = red_windows(rate_limits, int(time.time() * 1000))
    if red:
        return "Quota pace is red - run /session-handoff now, then stop.\n" + "\n".join(red)
    return None


CHECKS = {
    "context": check_context,
    "quota": check_quota,
    "idle": check_idle,
    "rgflags": check_rgflags,
}


def emit_block(event_name, reason):
    if event_name == "PreToolUse":
        out = {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        }
    else:
        out = {"decision": "block", "reason": reason}
    json.dump(out, sys.stdout)


def main(argv):
    try:
        data = json.load(sys.stdin)
    except (OSError, ValueError):
        data = {}
    session_id = data.get("session_id") or ""
    prompt = prompt_for_turn(data)
    state = arm_bypass(session_id, prompt) if session_id else {"turn": [], "session": []}
    event_name = data.get("hook_event_name") or ""
    tool_name = data.get("tool_name") or ""
    handoff = handoff_call(event_name, tool_name, tool_command(data))
    for name in argv:
        check = CHECKS.get(name)
        if check is None or bypassed(state, name):
            continue
        reason = check(data)
        if reason:
            if handoff and name not in NEVER_BYPASSED and HANDOFF_REASON_PATTERN.search(reason):
                continue
            emit_block(event_name, reason)
            return 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
