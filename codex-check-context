#!/usr/bin/env bash
# Codex PreToolUse hook (~/.codex/hooks.json).
# Blocks when context exceeds the token limit and directs the agent to run /session-handoff.
limit=170000
handoff_skill=session-handoff

input=$(cat)
transcript=$(echo "$input" | jq -r '.transcript_path // empty')
session_id=$(echo "$input" | jq -r '.session_id // empty')

if [[ -n "$session_id" ]]; then
  flag_file="/tmp/codex-${handoff_skill}-${session_id}"

  # Allow tool calls that are part of an in-progress session-handoff
  if [[ -f "$flag_file" ]]; then
    exit 0
  fi
fi

if [[ -n "$transcript" && -f "$transcript" ]]; then
  total_tokens=$(tac "$transcript" 2>/dev/null | jq -Rn '
    first(inputs | fromjson? | select(.type=="event_msg" and .payload.type=="token_count"))
    | .payload.info.last_token_usage.total_tokens
  ' 2>/dev/null)
  if [[ "$total_tokens" =~ ^[0-9]+$ ]] && ((total_tokens > limit)); then
    # Allow /session-handoff invocations through regardless of context
    last_msg=$(tac "$transcript" 2>/dev/null | jq -Rn '
      first(inputs | fromjson? | select(.type=="event_msg" and .payload.type=="user_message"))
      | .payload.message
    ' 2>/dev/null)
    if echo "$last_msg" | grep -qi "$handoff_skill"; then
      [[ -n "$session_id" ]] && touch "$flag_file"
      exit 0
    fi
    jq -n --arg reason "Context at ${total_tokens} tokens (>${limit}) - run /${handoff_skill} to capture the user's intent and what's left, then stop." \
      '{decision:"block",reason:$reason}'
  fi
fi
exit 0
