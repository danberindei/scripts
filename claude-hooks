#!/usr/bin/env python3
"""Consolidated Claude Code hook checks (UserPromptSubmit + PreToolUse).

Registered in ~/.claude*/settings.json. One invocation runs the checks named on
argv, in order, and blocks (exit 2) on the first that fails.

Usage:
    claude-hooks [--config DIR] CHECK [CHECK ...]
    CHECK is one of: context, quota, idle, rgflags

stdin is the hook JSON payload. --config DIR sets the config dir for the quota
check (default: $CLAUDE_CONFIG_DIR or ~/.claude); other checks ignore it.

Handoff bypass: a prompt containing session-handoff is allowed through. The
Skill(session-handoff) tool call is also allowed through, but later tool calls
remain subject to their checks. Each check keeps its own narrower bypasses (see
the individual functions).

A blocking check writes a JSON decision to stdout and exits 0; the shape depends
on the hook event (PreToolUse denies the tool call, other events block the
prompt). No output means allow. See emit_block.
"""

import json
import os
import re
import shlex
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

CONTEXT_LIMIT = 190000
IDLE_LIMIT = 59.5 * 60

HANDOFF_PROMPT_PATTERN = re.compile(r"session-handoff", re.IGNORECASE)
CONTEXT_BYPASS_PATTERN = re.compile(r"ignore context limit", re.IGNORECASE)
QUOTA_PERSISTENT_PATTERN = re.compile(r"ignore quota", re.IGNORECASE)
QUOTA_TEMPORARY_PATTERN = re.compile(
    r"continue in [0-9]+|snooze for [0-9.]+", re.IGNORECASE
)
IDLE_BYPASS_PATTERN = re.compile(r"\b(resume|continue)\b", re.IGNORECASE)
# System-injected prompts (subagent completion); the child already spent its tokens.
INJECTED_PROMPT_PATTERN = re.compile(r"<task-notification", re.IGNORECASE)

CACHE_TTL = 120
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
BETA_HEADER = "oauth-2025-04-20"

# label -> window duration in milliseconds
WINDOWS = [
    ("five_hour", 5 * 60 * 60 * 1000),
    ("seven_day", 7 * 24 * 60 * 60 * 1000),
    ("seven_day_opus", 7 * 24 * 60 * 60 * 1000),
    ("seven_day_sonnet", 7 * 24 * 60 * 60 * 1000),
]


def _remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def last_assistant_usage_tokens(path):
    """Sum input + cache tokens from the last assistant message in the transcript.

    Returns None if there is no assistant message with usage.
    """
    usage = None
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if entry.get("type") == "assistant":
                u = (entry.get("message") or {}).get("usage")
                if u:
                    usage = u
    if not usage:
        return None
    return (
        (usage.get("input_tokens") or 0)
        + (usage.get("cache_creation_input_tokens") or 0)
        + (usage.get("cache_read_input_tokens") or 0)
    )


def last_assistant_epoch(path):
    """Epoch seconds of the last assistant message, or None."""
    last = None
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if entry.get("type") == "assistant" and entry.get("timestamp"):
                last = entry["timestamp"]
    if not last:
        return None
    return datetime.fromisoformat(last.replace("Z", "+00:00")).timestamp()


def _bypass_path(session_id):
    return f"/tmp/claude-bypass-{session_id}"


def _load_bypass(session_id):
    """Read the per-session bypass state, or an empty state if absent/unreadable."""
    try:
        with open(_bypass_path(session_id), encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    return {
        "turn": list(data.get("turn") or []),
        "session": list(data.get("session") or []),
    }


def _save_bypass(session_id, state):
    """Persist the bypass state atomically, or remove the file when it is empty."""
    path = _bypass_path(session_id)
    if not state["turn"] and not state["session"]:
        _remove(path)
        return
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f)
        os.replace(tmp, path)
    except OSError:
        _remove(tmp)


def arm_bypass(session_id, prompt, tool_name, skill_arg):
    """Update and persist the per-session bypass state, then return it.

    Turn-scoped bypasses are cleared at the start of each new prompt and re-derived
    from it; session-scoped bypasses persist. Scopes:
      turn "all"      -- every check (a prompt containing session-handoff)
      turn "context"  -- context check   ("ignore context limit")
      turn "quota"    -- quota check      ("continue in X" / "snooze for X")
      session "quota" -- quota check for the rest of the session ("ignore quota")
    """
    state = _load_bypass(session_id)
    changed = False

    if prompt:
        # New turn: drop turn-scoped bypasses, then re-derive them from the prompt.
        state["turn"] = []
        changed = True
        if HANDOFF_PROMPT_PATTERN.search(prompt):
            state["turn"].append("all")
        if CONTEXT_BYPASS_PATTERN.search(prompt):
            state["turn"].append("context")
        if QUOTA_TEMPORARY_PATTERN.search(prompt):
            state["turn"].append("quota")
        if QUOTA_PERSISTENT_PATTERN.search(prompt) and "quota" not in state["session"]:
            state["session"].append("quota")

    if changed:
        _save_bypass(session_id, state)
    return state


# Checks that no bypass may unblock: a wrong flag is wrong during a handoff too.
NEVER_BYPASSED = {"rgflags"}


def bypassed(state, check):
    """True if this check is bypassed by the current state."""
    if check in NEVER_BYPASSED:
        return False
    return "all" in state["turn"] or check in state["turn"] or check in state["session"]


def check_context(data, config_dir):
    """Return a block reason when the last assistant message's context exceeds
    CONTEXT_LIMIT, else None.

    The "ignore context limit" bypass is handled centrally (see arm_bypass).
    """
    transcript = data.get("transcript_path") or ""
    if not transcript:
        return None
    try:
        tokens = last_assistant_usage_tokens(transcript)
    except OSError:
        return None
    if tokens is not None and tokens > CONTEXT_LIMIT:
        return (
            f"Context at {tokens} tokens (>{CONTEXT_LIMIT}) - invoke the "
            "session-handoff skill now (call Skill with skill='session-handoff'), "
            "then stop."
        )
    return None


def check_idle(data, config_dir):
    """Return a block reason when more than IDLE_LIMIT seconds have passed since
    the last assistant reply, else None. Bypass: whole-word "resume" or
    "continue" in the prompt.
    """
    prompt = data.get("prompt") or ""
    transcript = data.get("transcript_path") or ""

    if IDLE_BYPASS_PATTERN.search(prompt):
        return None
    if not transcript:
        return None
    try:
        last_epoch = last_assistant_epoch(transcript)
    except OSError:
        return None
    if last_epoch is None:
        return None

    idle = datetime.now(timezone.utc).timestamp() - last_epoch
    if idle > IDLE_LIMIT:
        mins = int(idle // 60)
        return (
            f"Blocked: {mins} min since the last assistant reply (>{IDLE_LIMIT}s). "
            "Add 'resume' or 'continue' to the message to proceed."
        )
    return None


SHELL_OPERATORS = {"|", "||", "&&", ";", "&", "(", ")", "<", ">", ">>", "<<"}
# rg short flags whose value may itself start with a dash.
RG_VALUE_FLAGS = {"-e", "-f", "-g", "--regexp", "--file", "--glob", "--iglob"}
RG_SHORT_R = re.compile(r"^-[A-Za-z]*r[A-Za-z]*$")


def rg_arg_spans(tokens):
    """Yield the argument tokens of each rg invocation in a shell token stream."""
    args = None
    for token in tokens:
        if args is None:
            if token == "rg" or token.endswith("/rg"):
                args = []
            continue
        if token in SHELL_OPERATORS:
            yield args
            args = None
            continue
        args.append(token)
    if args is not None:
        yield args


def check_rgflags(data, config_dir):
    """Return a block reason when a Bash command passes short -r to rg, else None.

    rg's -r is --replace=TEXT: `rg -rn PATTERN` prints the literal "n" for every
    match rather than numbering lines. r is rg's only short flag containing "r",
    so any short cluster containing it is a replace. --replace=TEXT is allowed.
    """
    if (data.get("tool_name") or "") != "Bash":
        return None
    tool_input = data.get("tool_input")
    command = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
    if "rg" not in command:
        return None
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return None

    for args in rg_arg_spans(tokens):
        skip = False
        for token in args:
            if skip:
                skip = False
                continue
            if token == "--":
                break
            if token in RG_VALUE_FLAGS:
                skip = True
                continue
            if RG_SHORT_R.match(token):
                return (
                    f"Blocked: `rg {token}` -- rg's -r is --replace=TEXT, not "
                    "recursive, so this prints a replacement instead of matching "
                    "lines. rg already searches recursively; use `rg -n PATTERN "
                    "PATH` for line numbers. For a real replacement write "
                    "--replace=TEXT."
                )
    return None


def parse_reset_ms(resets_at):
    """Parse an ISO 8601 reset timestamp to epoch milliseconds, or None."""
    if not resets_at:
        return None
    try:
        dt = datetime.fromisoformat(resets_at.replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return int(dt.timestamp() * 1000)


def _round_half_up(x):
    """Round to nearest integer, ties away from zero (matches jq `round`)."""
    return int(x + 0.5) if x >= 0 else -int(-x + 0.5)


def check_window(label, window, now_ms, dur_ms):
    """Return a red-pace message for this window, or None if it is fine or N/A.

    A window is red when the remaining percentage has fallen below half of the
    expected-remaining line for the elapsed fraction of the window.
    """
    if not window:
        return None
    util = window.get("utilization")
    reset_ms = parse_reset_ms(window.get("resets_at"))
    if util is None or reset_ms is None:
        return None
    if reset_ms <= now_ms:
        return None
    remaining = 100 - util
    elapsed_ms = dur_ms - max(reset_ms - now_ms, 0)
    elapsed_frac = elapsed_ms / dur_ms
    if elapsed_frac <= 0:
        return None
    expected_remaining = (1 - elapsed_frac) * 100
    if remaining < expected_remaining * 0.5:
        wait_min = (reset_ms - now_ms) // 60000
        return f"{label}: {_round_half_up(remaining)}% left, expected {_round_half_up(expected_remaining)}% (resets in {wait_min}m)"
    return None


def red_windows(usage, now_ms):
    """Return the list of red-pace messages across all quota windows."""
    return [
        msg
        for label, dur_ms in WINDOWS
        if (msg := check_window(label, usage.get(label), now_ms, dur_ms))
    ]


def cache_file(cfg_dir):
    base = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    cache_dir = os.path.join(base, "claude-pace")
    os.makedirs(cache_dir, exist_ok=True)
    return os.path.join(cache_dir, f"quota-hook-cache-{os.path.basename(cfg_dir)}")


def read_cache(path, now_s):
    try:
        if now_s - os.stat(path).st_mtime <= CACHE_TTL:
            with open(path, encoding="utf-8") as f:
                return f.read()
    except OSError:
        pass
    return None


def fetch_usage(cfg_dir, cache_path):
    """Fetch the usage payload, using the cache when fresh. Returns body text or None."""
    now_s = time.time()
    body = read_cache(cache_path, now_s)
    if body:
        return body

    credentials = os.path.join(cfg_dir, ".credentials.json")
    try:
        with open(credentials, encoding="utf-8") as f:
            token = json.load(f).get("claudeAiOauth", {}).get("accessToken")
    except (OSError, ValueError):
        return None
    if not token:
        return None

    req = urllib.request.Request(
        USAGE_URL,
        headers={"Authorization": f"Bearer {token}", "anthropic-beta": BETA_HEADER},
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            body = resp.read().decode("utf-8")
    except (urllib.error.URLError, OSError, ValueError):
        return None
    if not body:
        return None
    try:
        with open(cache_path, "w", encoding="utf-8") as f:
            f.write(body)
    except OSError:
        pass
    return body


def check_quota(data, config_dir):
    """Return a block reason when quota pace is red (remaining < half the expected
    line), else None.

    The "ignore quota" / "continue in X" / "snooze for X" bypasses are handled
    centrally (see arm_bypass). Injected subagent-completion prompts are never
    blocked, since the child already spent those tokens.
    """
    prompt = data.get("prompt") or ""
    if prompt and INJECTED_PROMPT_PATTERN.search(prompt):
        return None

    body = fetch_usage(config_dir, cache_file(config_dir))
    if not body:
        return None
    try:
        usage = json.loads(body)
    except ValueError:
        return None

    red = red_windows(usage, int(time.time() * 1000))
    if red:
        return (
            "Quota pace is red -- invoke the session-handoff skill now (call Skill "
            "with skill='session-handoff'), then stop.\n" + "\n".join(red)
        )
    return None


CHECKS = {
    "context": check_context,
    "quota": check_quota,
    "idle": check_idle,
    "rgflags": check_rgflags,
}


def emit_block(event_name, reason):
    """Write a JSON block decision for this hook event to stdout.

    PreToolUse denies the tool call via hookSpecificOutput; every other event
    blocks the prompt via the top-level decision field.
    """
    if event_name == "PreToolUse":
        out = {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        }
    else:
        out = {"decision": "block", "reason": reason}
    json.dump(out, sys.stdout)


def main(argv):
    config_dir = os.environ.get("CLAUDE_CONFIG_DIR")
    checks = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--config":
            i += 1
            if i < len(argv):
                config_dir = argv[i]
        else:
            checks.append(arg)
        i += 1
    config_dir = os.path.expanduser(config_dir) if config_dir else os.path.expanduser("~/.claude")

    try:
        data = json.load(sys.stdin)
    except (ValueError, OSError):
        data = {}

    session_id = data.get("session_id") or ""
    prompt = data.get("prompt") or ""
    tool_name = data.get("tool_name") or ""
    tool_input = data.get("tool_input")
    skill_arg = tool_input.get("skill", "") if isinstance(tool_input, dict) else ""
    is_handoff_skill = tool_name == "Skill" and skill_arg == "session-handoff"

    state = (
        arm_bypass(session_id, prompt, tool_name, skill_arg)
        if session_id
        else {"turn": [], "session": []}
    )

    event_name = data.get("hook_event_name") or ""
    for name in checks:
        if event_name == "PreToolUse" and is_handoff_skill:
            continue
        fn = CHECKS.get(name)
        if fn is None:
            continue
        if bypassed(state, name):
            continue
        reason = fn(data, config_dir)
        if reason:
            emit_block(event_name, reason)
            return 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
