@dataclass(frozen=True)
class ProcessInfo:
    pid: int
    ppid: int
    name: str
    executable: str
    argv: tuple[str, ...]
    cwd: str | None
    paseo_agent_id: str | None
    paseo_agent_cwd: str | None
    cgroup_path: str | None
    rss_kib: int
    rss_shmem_kib: int
    swap_kib: int


@dataclass(frozen=True)
class ProcessMemory:
    rss_kib: int
    pss_kib: int | None
    rss_shmem_kib: int
    pss_shmem_kib: int | None
    swap_kib: int
    swap_pss_kib: int | None

    @property
    def pss_available(self) -> bool:
        return self.pss_kib is not None

    @property
    def effective_pss_kib(self) -> int:
        return self.rss_kib if self.pss_kib is None else self.pss_kib

    @property
    def effective_pss_shmem_kib(self) -> int:
        return self.rss_shmem_kib if self.pss_shmem_kib is None else self.pss_shmem_kib

    @property
    def effective_swap_pss_kib(self) -> int:
        return self.swap_kib if self.swap_pss_kib is None else self.swap_pss_kib

    @property
    def effective_total_kib(self) -> int:
        return self.effective_pss_kib + self.effective_swap_pss_kib


