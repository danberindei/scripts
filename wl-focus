#!/usr/bin/env python3
# wl-focus: raise a Wayland window via the Switchboard GNOME Shell extension.
# Accepts multiple --title-regex args; each poll iteration tries them in order
# (first regex wins) against the current window list, so a caller can pass a
# specific match ahead of a general one. Polls for up to --wait seconds.
import argparse
import json
import re
import sys
import time

from jeepney import DBusAddress, new_method_call
from jeepney.io.blocking import open_dbus_connection

SWITCHBOARD = DBusAddress(
    "/org/gnome/Shell/Switchboard",
    bus_name="org.gnome.Shell.Switchboard",
    interface="org.gnome.Shell.Switchboard",
)


def get_windows(conn):
    # Switchboard returns the window list as a JSON-encoded string (GetWindows
    # is typed `out s`), so the reply body carries one native str to decode.
    reply = conn.send_and_get_reply(new_method_call(SWITCHBOARD, "GetWindows"))
    return json.loads(reply.body[0])


def find_win_id(windows, wm_class, patterns):
    for pattern in patterns:
        for w in windows:
            if w.get("wm_class") == wm_class and pattern.search(w.get("title", "")):
                return w.get("id")
    return None


def focus(conn, win_id):
    # FocusWindow is typed `in u windowId`; signature "u" marshals the uint32.
    conn.send_and_get_reply(new_method_call(SWITCHBOARD, "FocusWindow", "u", (win_id,)))


def main():
    parser = argparse.ArgumentParser(
        description="Raise a Wayland window matching wm-class and one or more title regexes.")
    parser.add_argument("--wm-class", required=True, help="WM_CLASS of the target application")
    parser.add_argument("--title-regex", required=True, action="append", metavar="REGEX",
                        help="Python regex matched against window title; repeatable, tried in order")
    parser.add_argument("--wait", type=float, default=0.0, metavar="SECS",
                        help="seconds to poll for a matching window before giving up (default: 0)")
    args = parser.parse_args()

    patterns = [re.compile(r) for r in args.title_regex]
    conn = open_dbus_connection(bus="SESSION")

    deadline = time.monotonic() + args.wait
    try:
        while True:
            win_id = find_win_id(get_windows(conn), args.wm_class, patterns)
            if win_id is not None:
                focus(conn, win_id)
                return
            if time.monotonic() >= deadline:
                break
            time.sleep(0.1)
    except Exception as exc:
        print(f"wl-focus: Switchboard/D-Bus error: {exc}", file=sys.stderr)
        sys.exit(1)

    print(f"wl-focus: no window found for wm_class={args.wm_class!r} "
          f"title_regex={args.title_regex!r} within {args.wait}s", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
