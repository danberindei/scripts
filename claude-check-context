#!/usr/bin/env bash
# Claude Code UserPromptSubmit + PreToolUse hook (~/.claude/settings.json).
# Blocks when context exceeds the token limit and directs the agent to run /session-handoff.
limit=170000
handoff_skill=session-handoff

input=$(cat)
transcript=$(echo "$input" | jq -r '.transcript_path // empty')
prompt=$(echo "$input" | jq -r '.prompt // empty')
session_id=$(echo "$input" | jq -r '.session_id // empty')
tool_name=$(echo "$input" | jq -r '.tool_name // empty')
skill_arg=$(echo "$input" | jq -r '.tool_input.skill // empty')

if [[ -n "$session_id" ]]; then
  flag_file="/tmp/claude-${handoff_skill}-${session_id}"

  # Let the agent reach the handoff skill even when over the limit, and bypass the
  # rest of the turn so the skill's own tool calls (reads, writing the handoff) pass.
  if [[ "$tool_name" == "Skill" && "$skill_arg" == "$handoff_skill" ]]; then
    touch "$flag_file"
    exit 0
  fi

  if [[ -n "$prompt" ]]; then
    # Clear the bypass at the start of each new prompt so it covers only the current turn.
    rm -f "$flag_file"
    # Allow "session handoff" or "ignore context limit" prompts through regardless of context.
    if echo "$prompt" | grep -Ei "session.handoff|ignore context limit" > /dev/null; then
      touch "$flag_file"
      exit 0
    fi
  fi

  # Allow tool calls within the bypassed turn through.
  if [[ -f "$flag_file" ]]; then
    exit 0
  fi
fi

if [[ -n "$transcript" && -f "$transcript" ]]; then
  input_tokens=$(tac "$transcript" | jq -Rn '
    first(inputs | fromjson? | select(.type=="assistant"))
    | .message.usage
    | (.input_tokens//0) + (.cache_creation_input_tokens//0) + (.cache_read_input_tokens//0)
  ' 2>/dev/null)
  if [[ "$input_tokens" =~ ^[0-9]+$ ]] && ((input_tokens > limit)); then
    echo "Context at ${input_tokens} tokens (>${limit}) - invoke the session-handoff skill now (call Skill with skill='session-handoff'), then stop." >&2
    exit 2
  fi
fi
exit 0
