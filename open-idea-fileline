#!/usr/bin/env bash
set -euo pipefail

# Kitty integration
#   map ctrl+shift+o kitten hints --type regex --regex '(?:[./~A-Za-z0-9_-]*/)[A-Za-z0-9._-]*\.[A-Za-z0-9_-]+:[0-9]+' --program /home/dan/Tools/bin/open-idea-fileline
# This script expects: path/to/file.ext:line
# Example match: .github/workflows/deploy-app.yml:97
# The regex requires an extension on the final filename segment, not just in directory names.

debug() {
  if [[ "${OPEN_IDEA_FILELINE_DEBUG:-0}" == "1" ]]; then
    msg="DEBUG: $*"
    echo "$msg" >&2
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" >> /tmp/open-idea-fileline.log
  fi
}

if [[ $# -lt 1 ]]; then
  echo "usage: $0 path/to/file.ext:line" >&2
  exit 2
fi

ref="$1"
if [[ "$ref" =~ :[0-9]+$ ]]; then
  file="${ref%:*}"
  line="${ref##*:}"
else
  file="$ref"
  line=""
fi
debug "input_ref=$ref"

if [[ -z "$file" || ( -n "$line" && ! "$line" =~ ^[0-9]+$ ) ]]; then
  echo "invalid reference: $ref (expected path/to/file.ext or path/to/file.ext:line)" >&2
  exit 2
fi

# Resolve relative paths from cwd first, then git root when available.
if [[ ! -f "$file" ]]; then
  if root="$(git rev-parse --show-toplevel 2>/dev/null)" && [[ -f "$root/$file" ]]; then
    file="$root/$file"
    debug "resolved_from_git_root=$file"
  fi
fi

# If the file path is incomplete, try resolving with fd within the git root.
if [[ ! -f "$file" ]] && [[ -n "${root:-}" ]] && command -v fd >/dev/null 2>&1; then
  wanted_suffix="${file#./}"
  mapfile -t fd_candidates < <(fd --type f --hidden --one-file-system --exclude .git -p --fixed-strings "$wanted_suffix" "$root" 2>/dev/null || true)

  if [[ ${#fd_candidates[@]} -eq 1 ]]; then
    file="${fd_candidates[0]}"
    debug "resolved_from_fd_suffix=$file"
  elif [[ ${#fd_candidates[@]} -gt 1 ]]; then
    echo "ambiguous file reference: $file" >&2
    printf 'matches:\n' >&2
    printf ' - %s\n' "${fd_candidates[@]}" >&2
    exit 1
  fi
fi

if [[ ! -f "$file" ]]; then
  echo "file not found: $file" >&2
  exit 1
fi
if command -v realpath >/dev/null 2>&1; then
  file="$(realpath "$file")"
fi
debug "final_file=$file final_line=$line"
idea_bin="/home/dan/Tools/bin/idea"
if [[ ! -x "$idea_bin" ]]; then
  echo "IntelliJ launcher wrapper not found: $idea_bin" >&2
  exit 1
fi
debug "idea_bin=$idea_bin"

"$idea_bin" ${line:+--line "$line"} "$file"
