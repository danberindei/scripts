#!/usr/bin/env python3
"""Claude Code UserPromptSubmit + PreToolUse hook: block tool calls when quota pace is red.

Register for BOTH events: UserPromptSubmit arms the bypass flag, PreToolUse checks quota.
Pacing target ends at 2% remaining at the window reset (not 0%), so the expected-remaining
line runs from 100% down to 2% over the window:
    red when remainingPercent < expectedRemainingPercent * 0.5

Caches the API response for CACHE_TTL seconds to avoid hammering the endpoint.

User bypass:
  "ignore quota"                          persistent: disables the check for the rest of the session.
  "continue in X min" / "snooze for Xh"   temporary: disables the check for the current turn only
                                          (cleared on the next prompt). The duration X is not enforced
                                          here; it is a signal for the LLM to schedule its own
                                          wakeup/task after that interval.
  "session handoff" / "hand off" / etc.   temporary: disables the check for the current turn only,
                                          so a handoff request isn't blocked by a red quota pace.

Exit codes: 0 = allow, 2 = block (message on stderr).
"""

import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

CACHE_TTL = 120
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
BETA_HEADER = "oauth-2025-04-20"

PERSISTENT_PATTERN = re.compile(r"ignore quota", re.IGNORECASE)
TEMPORARY_PATTERN = re.compile(
    r"continue in [0-9]+|snooze for [0-9.]+|session handoff|hand off|hand this to|wrap up",
    re.IGNORECASE,
)

# label -> window duration in milliseconds
WINDOWS = [
    ("five_hour", 5 * 60 * 60 * 1000),
    ("seven_day", 7 * 24 * 60 * 60 * 1000),
    ("seven_day_opus", 7 * 24 * 60 * 60 * 1000),
    ("seven_day_sonnet", 7 * 24 * 60 * 60 * 1000),
]


def parse_reset_ms(resets_at):
    """Parse an ISO 8601 reset timestamp to epoch milliseconds, or None if unparseable."""
    if not resets_at:
        return None
    try:
        dt = datetime.fromisoformat(resets_at.replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return int(dt.timestamp() * 1000)


def _round_half_up(x):
    """Round to nearest integer, ties away from zero (matches the old jq `round`)."""
    return int(x + 0.5) if x >= 0 else -int(-x + 0.5)


def check_window(label, window, now_ms, dur_ms):
    """Return a red-pace message for this window, or None if it is fine or not applicable.

    A window is red when the remaining percentage has fallen below half of the
    expected-remaining line for the elapsed fraction of the window.
    """
    if not window:
        return None
    util = window.get("utilization")
    reset_ms = parse_reset_ms(window.get("resets_at"))
    if util is None or reset_ms is None:
        return None
    if reset_ms <= now_ms:
        return None
    remaining = 100 - util
    elapsed_ms = dur_ms - max(reset_ms - now_ms, 0)
    elapsed_frac = elapsed_ms / dur_ms
    if elapsed_frac <= 0:
        return None
    expected_remaining = 2 + (1 - elapsed_frac) * 98
    if remaining < expected_remaining * 0.5:
        return f"{label}: {_round_half_up(remaining)}% left, expected {_round_half_up(expected_remaining)}%"
    return None


def red_windows(usage, now_ms):
    """Return the list of red-pace messages across all quota windows."""
    return [
        msg
        for label, dur_ms in WINDOWS
        if (msg := check_window(label, usage.get(label), now_ms, dur_ms))
    ]


def config_dir():
    if len(sys.argv) > 1 and sys.argv[1]:
        return os.path.expanduser(sys.argv[1])
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if env:
        return os.path.expanduser(env)
    return os.path.expanduser("~/.claude")


def cache_file(cfg_dir):
    base = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    cache_dir = os.path.join(base, "claude-pace")
    os.makedirs(cache_dir, exist_ok=True)
    return os.path.join(cache_dir, f"quota-hook-cache-{os.path.basename(cfg_dir)}")


def read_cache(path, now_s):
    try:
        if now_s - os.stat(path).st_mtime <= CACHE_TTL:
            with open(path, encoding="utf-8") as f:
                return f.read()
    except OSError:
        pass
    return None


def fetch_usage(cfg_dir, cache_path):
    """Fetch the usage payload, using the cache when fresh. Returns body text or None."""
    now_s = time.time()
    body = read_cache(cache_path, now_s)
    if body:
        return body

    credentials = os.path.join(cfg_dir, ".credentials.json")
    try:
        with open(credentials, encoding="utf-8") as f:
            token = json.load(f).get("claudeAiOauth", {}).get("accessToken")
    except (OSError, ValueError):
        return None
    if not token:
        return None

    req = urllib.request.Request(
        USAGE_URL,
        headers={"Authorization": f"Bearer {token}", "anthropic-beta": BETA_HEADER},
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            body = resp.read().decode("utf-8")
    except (urllib.error.URLError, OSError, ValueError):
        return None
    if not body:
        return None
    try:
        with open(cache_path, "w", encoding="utf-8") as f:
            f.write(body)
    except OSError:
        pass
    return body


def handle_bypass(session_id, prompt):
    """Arm/clear session bypass flags and report whether the quota check should be skipped.

    Returns True if the current invocation should exit 0 (allow) without checking quota.
    """
    flag_p = f"/tmp/claude-bypass-quota-p-{session_id}"
    flag_t = f"/tmp/claude-bypass-quota-t-{session_id}"

    # UserPromptSubmit: only this event carries .prompt.
    if prompt:
        _remove(flag_t)
        matched = False
        if PERSISTENT_PATTERN.search(prompt):
            _touch(flag_p)
            matched = True
        if TEMPORARY_PATTERN.search(prompt):
            _touch(flag_t)
            matched = True
        if matched:
            return True

    # PreToolUse (and non-matching prompts): skip the check if any bypass is armed.
    return os.path.exists(flag_p) or os.path.exists(flag_t)


def _touch(path):
    open(path, "a").close()


def _remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def main():
    try:
        data = json.load(sys.stdin)
    except (ValueError, OSError):
        data = {}
    session_id = data.get("session_id") or ""
    prompt = data.get("prompt") or ""

    if session_id and handle_bypass(session_id, prompt):
        return 0

    cfg_dir = config_dir()
    body = fetch_usage(cfg_dir, cache_file(cfg_dir))
    if not body:
        return 0
    try:
        usage = json.loads(body)
    except ValueError:
        return 0

    red = red_windows(usage, int(time.time() * 1000))
    if red:
        print("Quota pace is red -- stop and wait for reset.", file=sys.stderr)
        print("\n".join(red), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
