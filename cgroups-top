#!/usr/bin/env python3

import argparse
import io
import json
import os
import re
import shutil
import sys
from pathlib import Path

from top_common import (
    WatchDisplay,
    human_size,
    nonnegative_limit,
    positive_interval,
    read_cgroup_memory,
)

BOLD = "\033[1m"
BOLD_RESET = "\033[22m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
CYAN = "\033[36m"
RESET = "\033[0m"

CGROUPS_LEGEND = (
    'App/service Memory = cgroup RAM minus inactive file cache.',
    'Includes active file cache and kernel memory; neither is shown separately.',
    'App/service Total = Memory + Swap; Shmem is part of Memory.',
    'Executables: PSS + proportional swap (RSS fallback), not cgroup totals.',
)


def bold(text, enabled=False):
    if enabled:
        return f"{BOLD}{text}{BOLD_RESET}"
    return text


def color(text, code, enabled=False):
    if enabled:
        return f"{code}{text}{RESET}"
    return text


def build_watch_title(data):
    """Build watch title with total memory, shmem, and swap across real cgroups."""
    real_rows = [row for row in data if row.get('service') not in ('[free]', '[tmpfs]')]
    total_mem = sum(row.get('memory_bytes', 0) or 0 for row in real_rows)
    total_shmem = sum(row.get('shmem_bytes', 0) or 0 for row in real_rows)
    total_swap = sum(row.get('swap_bytes', 0) or 0 for row in real_rows)
    return f"cgroups-top {human_size(total_mem)} {human_size(total_shmem)} {human_size(total_swap)}"


def get_proc_comm(pid):
    """Get command name for a PID."""
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return None


def get_proc_cmdline(pid):
    """Get full command line for a PID."""
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_text()
        if cmdline:
            return ' '.join(cmdline.split('\x00')).strip()
        return None
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return None


def get_proc_memory(pid):
    """Get memory usage for a PID from /proc/pid/status."""
    try:
        status = Path(f"/proc/{pid}/status").read_text()
        rss_kb = 0
        file_kb = 0
        anon_kb = 0
        swap_kb = 0
        shmem_kb = 0

        for line in status.split('\n'):
            if line.startswith('VmRSS:'):
                rss_kb = int(line.split()[1])
            elif line.startswith('RssFile:'):
                file_kb = int(line.split()[1])
            elif line.startswith('RssAnon:'):
                anon_kb = int(line.split()[1])
            elif line.startswith('VmSwap:'):
                swap_kb = int(line.split()[1])
            elif line.startswith('RssShmem:'):
                shmem_kb = int(line.split()[1])

        return {
            'rss_bytes': rss_kb * 1024,
            'file_bytes': file_kb * 1024,
            'anon_bytes': anon_kb * 1024,
            'swap_bytes': swap_kb * 1024,
            'shmem_bytes': shmem_kb * 1024
        }
    except (FileNotFoundError, PermissionError, ProcessLookupError, ValueError):
        return {'rss_bytes': 0, 'file_bytes': 0, 'anon_bytes': 0, 'swap_bytes': 0, 'shmem_bytes': 0}


def get_proc_proportional(pid):
    """Read proportional memory (PSS) for a PID from /proc/pid/smaps_rollup.

    Returns None when smaps_rollup is unreadable so callers can fall back to RSS."""
    try:
        content = Path(f"/proc/{pid}/smaps_rollup").read_text()
        pss_kb = 0
        pss_shmem_kb = 0
        swap_pss_kb = 0
        for line in content.split('\n'):
            if line.startswith('Pss:'):
                pss_kb = int(line.split()[1])
            elif line.startswith('Pss_Shmem:'):
                pss_shmem_kb = int(line.split()[1])
            elif line.startswith('SwapPss:'):
                swap_pss_kb = int(line.split()[1])
        return {
            'pss_bytes': pss_kb * 1024,
            'pss_shmem_bytes': pss_shmem_kb * 1024,
            'swap_pss_bytes': swap_pss_kb * 1024,
        }
    except (FileNotFoundError, PermissionError, ProcessLookupError, OSError, ValueError):
        return None


def effective_proportional(proc):
    """Effective proportional memory for a process dict, falling back to RSS.

    Returns (pss, pss_shmem, swap_pss); each field uses smaps_rollup when the
    process was measured proportionally and the resident value otherwise."""
    proportional = proc.get('proportional')
    if proportional is None:
        return proc.get('rss_bytes', 0), proc.get('shmem_bytes', 0), proc.get('swap_bytes', 0)
    return (
        proportional['pss_bytes'],
        proportional['pss_shmem_bytes'],
        proportional['swap_pss_bytes'],
    )


def get_meminfo():
    """Parse /proc/meminfo into a dict of name -> kB."""
    info = {}
    for line in Path("/proc/meminfo").read_text().split('\n'):
        parts = line.split()
        if len(parts) >= 2:
            key = parts[0].rstrip(':')
            try:
                info[key] = int(parts[1])
            except ValueError:
                pass
    return info


def get_tmpfs_usage():
    """Get total bytes used across all tmpfs mounts."""
    total_used = 0
    seen = set()
    try:
        for line in Path("/proc/mounts").read_text().split('\n'):
            parts = line.split()
            if len(parts) >= 3 and parts[2] == 'tmpfs':
                mountpoint = parts[1]
                if mountpoint in seen:
                    continue
                seen.add(mountpoint)
                try:
                    stat = os.statvfs(mountpoint)
                    total_used += (stat.f_blocks - stat.f_bfree) * stat.f_frsize
                except (PermissionError, OSError):
                    pass
    except (FileNotFoundError, PermissionError):
        pass
    return total_used


def get_synthetic_entries():
    """Return synthetic entries for free memory+swap and tmpfs."""
    meminfo = get_meminfo()
    total_mem = meminfo.get('MemTotal', 0) * 1024
    free_mem = meminfo.get('MemFree', 0) * 1024
    available_mem = meminfo.get('MemAvailable', 0) * 1024
    free_swap = meminfo.get('SwapFree', 0) * 1024
    reclaimable_cache = max(0, available_mem - free_mem)
    tmpfs_used = get_tmpfs_usage()

    return [
        {
            'memory_bytes': free_mem,
            'swap_bytes': free_swap,
            'shmem_bytes': reclaimable_cache,
            'available_bytes': available_mem,
            'total_bytes': total_mem,
            'root_pid': None,
            'service': '[free]',
            'executables': [],
            'processes': [],
            'cgroup_path': '',
            'pids': [],
        },
        {
            'memory_bytes': tmpfs_used,
            'swap_bytes': None,
            'shmem_bytes': None,
            'root_pid': None,
            'service': '[tmpfs]',
            'executables': [],
            'processes': [],
            'cgroup_path': '',
            'pids': [],
        },
    ]


def iter_cgroup_dirs(root="/sys/fs/cgroup"):
    """Yield each cgroup directory with its file names, excluding the root."""
    root_path = Path(root)
    for parent, _directories, files in os.walk(root):
        if Path(parent) == root_path:
            continue
        yield Path(parent), files


def cgroup_display_name(name):
    """Remove unit naming scaffolding while preserving the full unit as its ID."""
    if name.startswith('app-') and name.endswith('.slice'):
        name = name[4:-6]
    elif name.endswith('.scope'):
        name = re.sub(r'-\d+$', '', name[:-6])
        name = re.sub(r'^app-(?:gnome-|glib-)?', '', name)
    return re.sub(r'\\x([0-9a-fA-F]{2})', lambda match: chr(int(match[1], 16)), name)


def cgroup_group_root(directory, entries):
    """Select an app slice or enclosing service/scope for a populated cgroup."""
    ancestors = [path for path in reversed(directory.parents) if path in entries] + [directory]
    app_slices = [path for path in ancestors if path.name.startswith('app-') and path.name.endswith('.slice')]
    if app_slices:
        return app_slices[0]
    for path in ancestors:
        if path.name.endswith(('.service', '.scope')) and not re.fullmatch(r'user@\d+\.service', path.name):
            return path
    return directory


def embedded_browser_owner(pid):
    """Return JCEF's parent PID without treating Chromium's app ID as ownership."""
    try:
        process = Path(f'/proc/{pid}')
        if (process / 'exe').readlink().name != 'cef_server':
            return None
        for line in (process / 'status').read_text().splitlines():
            if line.startswith('PPid:'):
                return int(line.split()[1])
    except (OSError, ValueError):
        pass
    return None


def attribute_embedded_browsers(directory_pids, groups, usages):
    """Transfer detached JCEF scope counters and processes to their launching app.

    Chromium and JCEF register the same app ID. A scope already included in
    an app slice must be subtracted before its counters are added elsewhere.
    These are display assignments; this function does not move host processes.
    """
    pid_roots = {pid: root for root, pids in groups.items() for pid in pids}
    included = {}
    excluded = {}
    for directory, members in directory_pids.items():
        match = re.fullmatch(r'app-org\.chromium\.Chromium(?:\.[a-z]+)?-(\d+)\.scope', directory.name)
        if not match:
            continue
        pid = int(match[1])
        if pid not in members:
            continue
        parent_pid = embedded_browser_owner(pid)
        source = pid_roots.get(pid)
        target = pid_roots.get(parent_pid)
        if source is None or target is None or source == target:
            continue
        try:
            branch_usage = read_cgroup_memory(directory)
        except (OSError, ValueError):
            continue
        if source not in usages or target not in usages:
            continue
        branch_pids = set().union(*(pids for path, pids in directory_pids.items()
                                   if path == directory or directory in path.parents))
        if source == directory:
            branch_usage = usages[source]
            groups.pop(source)
            usages.pop(source)
        else:
            for key, value in branch_usage.items():
                # The parent and child counters can change between reads.
                branch_usage[key] = min(value, usages[source][key])
                usages[source][key] -= branch_usage[key]
            groups[source].difference_update(branch_pids)
            excluded.setdefault(source, []).append(str(directory))
        for key, value in branch_usage.items():
            usages[target][key] += value
        groups[target].update(branch_pids)
        included.setdefault(target, []).append(str(directory))
    return included, excluded


def collect_cgroup_data():
    """Collect nonoverlapping app and service subtrees using parent counters."""
    results = []
    required = {'memory.current', 'memory.stat', 'cgroup.procs'}
    entries = {directory: set(files) for directory, files in iter_cgroup_dirs()}
    entries = {directory: files for directory, files in entries.items() if required <= files}
    groups = {}
    directory_pids = {}
    for directory in entries:
        try:
            pids = {int(pid) for pid in (directory / 'cgroup.procs').read_text().split()}
        except (OSError, ValueError):
            continue
        if pids:
            directory_pids[directory] = pids
            root = cgroup_group_root(directory, entries)
            groups.setdefault(root, set()).update(pids)

    usages = {}
    for directory in groups:
        try:
            usages[directory] = read_cgroup_memory(directory)
        except (OSError, ValueError):
            continue
    included, excluded = attribute_embedded_browsers(directory_pids, groups, usages)

    for cgroup_dir, members in groups.items():
        if cgroup_dir not in usages:
            continue
        try:
            usage = usages[cgroup_dir]
            if not members and not any(usage.values()):
                continue
            pids = sorted(members)
            root_pid = pids[0] if pids else None

            exes = set()
            processes = []
            for pid in pids:
                comm = get_proc_comm(pid)
                if comm:
                    exes.add(comm)
                cmdline = get_proc_cmdline(pid) or comm or ''
                mem = get_proc_memory(pid)
                # rss_bytes already includes anon_bytes + file_bytes + shmem_bytes
                total = mem['rss_bytes'] + mem['swap_bytes']
                processes.append({
                    'pid': pid,
                    'comm': comm,
                    'cmdline': cmdline,
                    **mem,
                    'total_bytes': total
                })

            processes.sort(key=lambda x: x['total_bytes'], reverse=True)

            results.append({
                **usage,
                'root_pid': root_pid,
                'service': cgroup_dir.name,
                'name': cgroup_display_name(cgroup_dir.name),
                'process_count': len(pids),
                'executables': sorted(exes),
                'processes': processes,
                'cgroup_path': str(cgroup_dir),
                'included_cgroup_paths': included.get(cgroup_dir, []),
                'excluded_cgroup_paths': excluded.get(cgroup_dir, []),
                'pids': pids
            })

        except (OSError, ValueError):
            continue

    # Sort by total usage (memory + swap).
    # memory_bytes already includes shmem.
    results.sort(key=lambda x: x['memory_bytes'] + (x['swap_bytes'] or 0), reverse=True)
    return results


def get_terminal_width():
    """Get terminal width if output is interactive."""
    is_tty = sys.stdout.isatty()
    if is_tty:
        terminal_width = shutil.get_terminal_size().columns
    else:
        terminal_width = None
    return is_tty, terminal_width


def print_cgroups_table(data, watch_mode=False, file=sys.stdout):
    """Print cgroup data in aligned table format."""
    if not data:
        return

    is_tty, terminal_width = get_terminal_width()

    # Calculate max widths
    max_pid_width = max(3, max(len(str(row['root_pid'])) if row['root_pid'] is not None else 0 for row in data))
    name_width = max(11, max(len(row.get('name', row['service'])) for row in data))

    # Print header
    header = f"{'Total':>9} {'Memory':>9} {'Shmem':>9} {'Swap':>9} {'PID':>{max_pid_width}} {'Procs':>5} {'App/Service':{name_width}} {'Executables (PSS+Swap)'}"
    print(bold(header, watch_mode), file=file)

    # Calculate fixed width for clipping. Executables column will include per-executable memory totals.
    fixed_width = 40 + max_pid_width + 1 + 6 + name_width + 1
    if is_tty:
        exes_width = max(20, terminal_width - fixed_width)
    else:
        exes_width = None

    for row in data:
        # memory_bytes already includes shmem
        total_bytes = row['memory_bytes'] + (row['swap_bytes'] or 0)
        total_str = human_size(total_bytes)
        memory_str = human_size(row['memory_bytes']) if row['shmem_bytes'] is not None else ''
        shmem_str = human_size(row['shmem_bytes']) if row['shmem_bytes'] is not None else ''
        swap_str = human_size(row['swap_bytes']) if row['swap_bytes'] is not None else ''
        pid_str = str(row['root_pid']) if row['root_pid'] is not None else ''
        service = row['service']
        name = row.get('name', service)
        count = str(row['process_count']) if 'process_count' in row else ''

        # Aggregate proportional memory per executable name (prefer /proc/<pid>/comm).
        # PSS splits shared pages across every process mapping them, so summing it
        # per executable avoids the double-counting that summing RSS would introduce.
        exe_proportional = {}
        for p in (row.get('processes') or []):
            comm = p.get('comm') or ''
            if not comm:
                # fallback to first token of cmdline
                cmd = p.get('cmdline') or ''
                comm = cmd.split(' ')[0] if cmd else ''

            proportional = get_proc_proportional(p['pid'])
            pss, _pss_shmem, swap_pss = effective_proportional({**p, 'proportional': proportional})
            exe_proportional[comm] = exe_proportional.get(comm, 0) + pss + swap_pss

        exe_items = list(exe_proportional.items())
        exe_items.sort(key=lambda x: x[1], reverse=True)
        exes_with_mem = [f"{human_size(size)} {name}" for name, size in exe_items if name]
        exes_str = ', '.join(exes_with_mem)

        # Clip executables string to available width
        if exes_width and len(exes_str) > exes_width:
            exes_str = exes_str[:exes_width-3] + '...'

        memory_col = bold(f"{memory_str:>9}", watch_mode)
        row_text = f"{total_str:>9} {memory_col} {shmem_str:>9} {swap_str:>9} {pid_str:>{max_pid_width}} {count:>5} {name:{name_width}} {exes_str}"
        if is_tty and service == '[free]':
            available_bytes = row.get('available_bytes')
            total_mem = row.get('total_bytes') or 0
            available_ratio = (available_bytes / total_mem) if available_bytes is not None and total_mem else None
            if available_ratio is not None and available_ratio < 0.10:
                row_text = color(row_text, RED, True)
            elif available_ratio is not None and available_ratio < 0.20:
                row_text = color(row_text, YELLOW, True)
            else:
                row_text = color(row_text, GREEN, True)
        elif is_tty and service == '[tmpfs]':
            row_text = color(row_text, CYAN, True)
        print(row_text, file=file)
    print('\n'.join(CGROUPS_LEGEND), file=file)


def print_processes_table(data, title=None, watch_mode=False, file=sys.stdout):
    """Print process data in aligned table format."""
    if not data:
        return

    is_tty, terminal_width = get_terminal_width()

    if title:
        print(title, file=file)

    # Calculate max widths
    max_pid_width = max(len(str(row['pid'])) for row in data)

    # Print header
    header = f"{'Total':>9} {'PSS':>9} {'Shmem':>9} {'Swap':>9} {'PID':>{max_pid_width}} {'COMMAND'}"
    print(bold(header, watch_mode), file=file)

    # Calculate fixed width for clipping
    fixed_width = 9 + 1 + 9 + 1 + 9 + 1 + 9 + 1 + max_pid_width + 1
    if is_tty:
        cmdline_width = max(20, terminal_width - fixed_width)
    else:
        cmdline_width = None

    for row in data:
        # PSS splits shared pages across mappers; a process whose smaps_rollup is
        # unreadable falls back to RSS.
        pss_bytes, pss_shmem_bytes, swap_pss_bytes = effective_proportional(row)
        total_bytes = pss_bytes + swap_pss_bytes
        total_str = human_size(total_bytes)
        pss_str = human_size(pss_bytes)
        shmem_str = human_size(pss_shmem_bytes)
        swap_str = human_size(swap_pss_bytes)
        pid_str = str(row['pid'])
        cmdline = row['cmdline']

        if cmdline_width and len(cmdline) > cmdline_width:
            cmdline = cmdline[:cmdline_width-3] + '...'

        memory_col = bold(f"{pss_str:>9}", watch_mode)
        print(f"{total_str:>9} {memory_col} {shmem_str:>9} {swap_str:>9} {pid_str:>{max_pid_width}} {cmdline}", file=file)


def print_jsonl(data, include_processes=False, file=sys.stdout):
    """Print data in JSON Lines format."""
    for row in data:
        output = {k: v for k, v in row.items() if k not in ['processes', 'pids']}
        output['total_bytes'] = row['memory_bytes'] + (row['swap_bytes'] or 0)
        # Add a simple exe field (first executable name) to make grouping by executable easier with jq
        exe = None
        exes = row.get('executables') or []
        if exes:
            exe = exes[0]
        output['exe'] = exe
        if include_processes:
            output['processes'] = row['processes']
        print(json.dumps(output), file=file)


def show_cgroup_processes(cgroup_name, limit=10, watch_mode=False, file=sys.stdout):
    """Show processes in a selected cgroup and all of its descendants.

    Select by full unit name, full path, or a unique displayed app name.
    """
    rows = collect_cgroup_data()
    grouped = [row for row in rows if cgroup_name in (row['service'], row['cgroup_path'])]
    grouped = grouped or [row for row in rows if row['name'] == cgroup_name]
    entries = list(iter_cgroup_dirs())
    exact = [directory for directory, _files in entries
             if cgroup_name in (directory.name, str(directory))]
    if exact:
        matches = exact
    elif len(grouped) == 1:
        matches = [Path(grouped[0]['cgroup_path'])]
    else:
        matches = [directory for directory, _files in entries
                   if cgroup_display_name(directory.name) == cgroup_name]
    if len(matches) != 1:
        reason = 'is ambiguous' if matches else 'not found'
        print(f"Cgroup '{cgroup_name}' {reason}", file=sys.stderr)
        return False
    selected = matches[0]
    if len(grouped) == 1 and grouped[0]['cgroup_path'] == str(selected):
        pids = set(grouped[0]['pids'])
    else:
        pids = set()
        for directory, files in entries:
            if directory != selected and selected not in directory.parents:
                continue
            if 'cgroup.procs' not in files:
                continue
            try:
                pids.update(int(pid) for pid in (directory / 'cgroup.procs').read_text().split())
            except (OSError, ValueError):
                continue

    processes = []
    for pid in sorted(pids):
        cmdline = get_proc_cmdline(pid) or get_proc_comm(pid)
        if cmdline:
            processes.append({
                'pid': pid,
                'cmdline': cmdline,
                'proportional': get_proc_proportional(pid),
                **get_proc_memory(pid),
            })
    def total(proc):
        pss, _shmem, swap = effective_proportional(proc)
        return pss + swap
    processes.sort(key=total, reverse=True)
    if limit > 0:
        processes = processes[:limit]
    if not processes:
        print(f'Cgroup: {selected} (no processes)', file=file)
    else:
        print_processes_table(processes, title=f'Cgroup: {selected}', watch_mode=watch_mode, file=file)
    return True


def run_once(args, limit=None, file=sys.stdout):
    if limit is None:
        limit = args.limit
    styled = args.watch and sys.stdout.isatty()
    if args.processes:
        if not show_cgroup_processes(args.processes, limit, watch_mode=styled, file=file) and not args.watch:
            sys.exit(1)
        return None

    data = collect_cgroup_data()

    if not args.json and not args.processes:
        data = data + get_synthetic_entries()
        data.sort(key=lambda x: x['memory_bytes'] + (x['swap_bytes'] or 0), reverse=True)

    # Apply limit for table output
    if not args.json and limit > 0:
        data = data[:limit]

    if args.json:
        print_jsonl(data, include_processes=args.include_processes, file=file)
    else:
        print_cgroups_table(data, watch_mode=styled, file=file)
    return data


def main():
    parser = argparse.ArgumentParser(description='Display cgroup memory usage')
    parser.add_argument('--json', action='store_true', help='Output in JSON Lines format')
    parser.add_argument('--processes', metavar='CGROUP', help='Show individual process memory for a specific cgroup')
    parser.add_argument('--include-processes', action='store_true', help='Include process details in JSON output')
    parser.add_argument('-n', '--limit', type=nonnegative_limit, default=10, help='Number of entries in one-shot output (default: 10, use 0 for all; watch shows all)')
    parser.add_argument('--watch', action='store_true', help='Refresh output periodically')
    parser.add_argument('--interval', type=positive_interval, default=2, help='Refresh interval in seconds (default: 2)')
    parser.epilog = (
        ' '.join(CGROUPS_LEGEND) + ' App slices include descendant processes. Detached JCEF scopes are '
        'attributed to their launching app in the display; JSON records included '
        'and excluded cgroup paths. Watch controls: Up/Down, PgUp/PgDn, Home/End, q.'
    )
    args = parser.parse_args()

    try:
        if args.watch:
            with WatchDisplay(
                enabled=not args.json,
                header_lines=2 if args.processes else 1,
                footer_lines=0 if args.processes or args.json else len(CGROUPS_LEGEND),
            ) as display:
                while True:
                    buf = io.StringIO()
                    data = run_once(args, limit=0, file=buf)
                    title = build_watch_title(data) if data and not args.json else 'cgroups-top'
                    display.render(buf.getvalue().rstrip('\n'), title)
                    if not display.wait(args.interval):
                        break
        else:
            run_once(args)
    except KeyboardInterrupt:
        pass
    except BrokenPipeError:
        print("Broken pipe", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
